                    commit(key_name, edit or dflt)
                    edit = None
                elif k in (curses.KEY_BACKSPACE, 127, 8):
                    edit = edit[:-1]
                elif ord("0") <= k <= ord("9") and len(edit) < 5:
                    edit += chr(k)
                continue
            if k == 27:
                return
            if k in (curses.KEY_DOWN, ord("j")):
                cur = min(cur + 1, len(SETTINGS) - 1)
            elif k in (curses.KEY_UP, ord("k")):
                cur = max(0, cur - 1)
            elif k in (curses.KEY_ENTER, 10, 13, ord(" ")):
                if kind == "bool":
                    commit(key_name,
                           "false" if str(cfg.get(key_name, dflt)).lower() == "true"
                           else "true")
                elif kind == "action":
                    if key_name == "repos":
                        repo_sync_modal()
                    elif key_name == "clear cache":
                        clear_cache()
                        for c in caches.values():
                            c.update(states={}, nodes={})
                        state["cover"] = {"days": 0, "states": set(), "repos": set()}
                        sync_due = time.time()
                        modal_msg("cache cleared, full sync started")
                        time.sleep(0.8)
                    else:
                        authors_modal()
                else:
                    edit = ""

