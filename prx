                "startedAt": at, "checkSuite": {"workflowRun": {"runNumber": num, "databaseId": 900 + num,
                                                               "workflow": {"name": wf}}}}
    stale = {"state": "FAILURE", "contexts": {"nodes": [  # failed, then re-run green
