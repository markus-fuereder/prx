            lang_by_name = {r["name"]: (r.get("primaryLanguage") or {}).get("name", "")
                            for r in repos}
            cfg_by_slug = {repo_slug(r["url"]): r for r in cfg["repos"]}
            checked = {n for n in names if f"{org}/{n}" in cfg_by_slug}
            meta = {}
            for n in names:
                old = cfg_by_slug.get(f"{org}/{n}", {})
