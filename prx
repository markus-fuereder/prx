def iso_days_ago(days):
    # gh timestamps are "...Z" UTC; same format makes string comparison valid
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() - days * 86400))


def age_str(created, hours=False):
    """Days since a timestamp, max 3 chars: 3d, 21d, capped at 99d. With
    hours, under a day shows hours instead: 0h…23h."""
    try:
        secs = time.time() - calendar.timegm(time.strptime(created, "%Y-%m-%dT%H:%M:%SZ"))
    except (ValueError, TypeError):
        return "-"
    if hours and secs < 86400:
        return f"{max(int(secs // 3600), 0)}h"
    return f"{min(max(int(secs // 86400), 0), 99)}d"


def since_str(ts):
    """Age of the last sync, one unit, max 3 chars: 42s, 3m, 2h, 6d, 54w."""
    s = max(0, int(time.time() - ts))
    for step, unit, cap in ((60, "s", 60), (60, "m", 60), (24, "h", 24),
                            (7, "d", 7), (54, "w", 54)):
        if s < cap:
            return f"{s}{unit}"
        s //= step
    return "54w"


# ponytail: YAML-subset parser (lists of flat key: value maps, comments, quotes).
# Swap for PyYAML if the config ever needs nesting/anchors.
def parse_config(text):
    cfg, section, item = {"repos": [], "authors": []}, None, None
    for raw in text.splitlines():
        line = raw.split("#", 1)[0].rstrip()
        if not line.strip():
            continue
        if not line.startswith(" "):
            if line.endswith(":"):
                section = line[:-1].strip()
                cfg.setdefault(section, [])
            elif ":" in line:
                k, v = line.split(":", 1)
                cfg[k.strip()] = v.strip().strip("'\"")
            continue
        stripped = line.strip()
        if stripped.startswith("- "):
            item = {}
            cfg[section].append(item)
            stripped = stripped[2:]
        if ":" in stripped and item is not None:
            k, v = stripped.split(":", 1)
            item[k.strip()] = v.strip().strip("'\"")
    return cfg


def repo_slug(url):
    return "/".join(url.rstrip("/").removesuffix(".git").split("/")[-2:])


# ponytail: one global cap on in-flight gh reads. GitHub GraphQL is bound by
# server CPU time per minute, so more slots cause 403s, not faster syncs.
GH_SLOTS = threading.BoundedSemaphore(12)
GH_TRIES = 3
GH_TIMEOUT = 60  # s per gh call; GitHub itself gives up after ~10 s with a 502/504


def gh_transient(stderr):
    """'limit' for the secondary rate limit, None for other 4xx (a retry would
    fail the same way), else 'retry' — 5xx, timeouts, truncated JSON."""
    if re.search(r"secondary rate limit|HTTP 429", stderr, re.I):
        return "limit"
    if re.search(r"HTTP 4\d\d|Could not resolve", stderr):
        return None
    return "retry"


def gh_read(args):
    """Run a read-only gh command under GH_SLOTS, retrying transient failures
    with jittered backoff. Never use this for mutations: a retry could repeat them."""
    for attempt in range(GH_TRIES):
        with GH_SLOTS:
            try:
                out = subprocess.run(["gh"] + args, capture_output=True, text=True,
                                     timeout=GH_TIMEOUT)
            except subprocess.TimeoutExpired:  # a hung connection: kill gh, retry
                out = subprocess.CompletedProcess(args, 124, "", f"gh timed out after {GH_TIMEOUT}s")
        kind = out.returncode and gh_transient(out.stderr)
        if not kind or attempt == GH_TRIES - 1:
            return out
        # GitHub asks for at least a minute after a secondary rate limit
        time.sleep((60 if kind == "limit" else 2 ** attempt) * random.uniform(1, 1.5))


def gh_err(out):
    return (out.stderr.strip().splitlines() or ["gh failed"])[-1]


def fetch_page(owner, name, state, after):
    """One page (50) of one PR state, newest first. Returns (nodes, next_cursor, err)."""
    args = ["api", "graphql", "-f", f"query={QUERY}", "-f", f"owner={owner}",
            "-f", f"name={name}", "-f", f"state={state}"]
    if after:
        args += ["-f", f"after={after}"]
    out = gh_read(args)
    if out.returncode != 0:
        return None, None, gh_err(out)
    prs = json.loads(out.stdout)["data"]["repository"]["pullRequests"]
    nxt = prs["pageInfo"]["endCursor"] if prs["pageInfo"]["hasNextPage"] else None
    nodes = prs["nodes"]
    # stack layers are too heavy for the list query (GitHub 504s): fetch them
    # per PR, only for open stack layers, where `land` depends on them
    upper = [i for i, n in enumerate(nodes)
             if n.get("stack") and n["state"] == "OPEN"]
    if upper:
        with concurrent.futures.ThreadPoolExecutor(max_workers=len(upper)) as pool:
            fulls = pool.map(lambda i: fetch_pr_node(owner, name, nodes[i]["number"])[0], upper)
            for i, full in zip(upper, fulls):
                nodes[i] = full or nodes[i]
    return nodes, nxt, None


MAX_PAGES = 12  # ponytail: 600 PRs/state/repo cap; raise if a repo outgrows it


def fetch_state(owner, name, state, cutoff):
    """Page through one PR state until past the cutoff."""
    nodes, after = [], None
    for _ in range(MAX_PAGES):
        page, after, err = fetch_page(owner, name, state, after)
        if err:
            return None, err
        nodes += page
        if not after or (page and page[-1]["updatedAt"] < cutoff):
            break
    return nodes, None


def gh_json(args):
    out = gh_read(args)
    if out.returncode != 0:
        return None, gh_err(out)
    return json.loads(out.stdout), None


