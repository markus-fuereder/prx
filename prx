    assert classify(bare)["comments"] == [0, 0, 0]  # cached before threads were fetched
    assert fix_steps(14575, "feat/b", "feat/a")[:2] == ["gh stack checkout 14575", "gh stack rebase"]
    assert fix_steps(None, "feat/b", "feat/a")[1:3] == ["git switch feat/b", "git rebase origin/feat/a"]
