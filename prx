    node["stack"]["entries"]["nodes"][0]["pullRequest"]["mergeStateStatus"] = "UNKNOWN"
    node["stack"]["entries"]["nodes"].append(
        {"position": 0, "pullRequest": dict(layer(5, "BLOCKED"), state="MERGED")})
    assert brow()["action"] == "land"  # merged layers below don't count
    node["stack"]["entries"]["nodes"][1]["pullRequest"]["mergeStateStatus"] = "BLOCKED"
    assert brow()["action"] == "chase"  # bottom not CLEAN: no land
    node.update(baseRefName="development", mergeStateStatus="CLEAN")
    assert brow()["action"] == "merge"  # stack not ready: its bottom merges like any PR
    node["stack"]["entries"]["nodes"][1]["pullRequest"]["mergeStateStatus"] = "CLEAN"
    assert brow()["action"] == "land"  # whole stack ready: the bottom lands too
    top = dict(layer(8, "BLOCKED"))
    top["commits"] = {"nodes": [{"commit": {"statusCheckRollup": {"state": "FAILURE"}}}]}
    node["stack"]["entries"]["nodes"].append({"position": 3, "pullRequest": top})
    node.update(baseRefName="feat/p")
    assert brow()["action"] == "chase"  # a layer above isn't ready: no land anywhere
    node["stack"]["entries"]["nodes"].pop()
    r = brow()
    assert r["action"] == "land" and [ly["number"] for ly in r["stack"]["layers"]] == [6, 7], r
    # plain chain 1 <- 2 <- 3: with gh-stack every ready layer offers stack
    global STACK_LINK

    def chain_row(n, base, parent):
        node.update(number=n, headRefName=f"b{n}", baseRefName=base, stack=None, stackEntry=None,
                    baseRef={"associatedPullRequests": {"nodes": [{"number": parent}] if parent else []}})
        return brow()
    chain = [chain_row(1, "development", None), chain_row(2, "b1", 1), chain_row(3, "b2", 2)]
    assert [r["action"] for r in mark_chains(chain)] == ["merge", "hold", "hold"]
    STACK_LINK = True
    assert [r["action"] for r in mark_chains(chain)] == ["stack", "stack", "stack"]
    assert [r["kids"] for r in chain] == [[2], [3], []]
    assert [r["m"] for r in chain] == ["stack", "stack", "stack"]
    for r in chain:
        r["method"] = "MERGE"  # a lone merge keeps the layers above valid: no stack action
    assert [r["action"] for r in mark_chains(chain)] == ["merge", "hold", "hold"]
    assert [r["m"] for r in chain] == ["merge", "stack", "stack"]  # linking stays on M
    chain[2]["ci"] = "YELLOW"  # not ready: the action says wait, M still links
    assert (mark_chains(chain)[2]["action"], chain[2]["m"]) == ("wait", "stack")
    assert mark_chains(chain[:1])[0]["action"] == "merge"  # lone PR: nothing to link
    tree = chain[:2] + [chain_row(4, "b1", 1)]  # 1 <- 2 and 1 <- 4: a stack can't fork
    assert [r["action"] for r in mark_chains(tree)] == ["merge", "hold", "hold"]
    assert [r["m"] for r in tree] == ["merge", None, None]  # trees never link
    assert row_hint(tree[0], False) == ("M", "merge")
    # out of date: trunk-only drift stays quiet, drift inside a chain marks it all
    STACK_LINK = False
    d = [chain_row(1, "development", None), chain_row(2, "b1", 1), chain_row(3, "b2", 2)]
    d[0]["behind"] = 5  # bottom behind trunk only: M offers update where it has nothing better
    assert [r["action"] for r in mark_chains(d)] == ["merge", "hold", "hold"]
    assert [r["m"] for r in d] == ["merge", "update", "update"]
    d[2]["behind"] = 1  # top behind its parent: no layer lands before the chain is updated
    assert [r["action"] for r in mark_chains(d)] == ["update", "update", "update"]
    d[1]["mergeable"] = "CONFLICTING"  # the update would be refused: offered nowhere
    assert [(r["action"], r["m"]) for r in mark_chains(d)] == [("merge", "merge"), ("rebase", None), ("hold", None)]
    lone = chain_row(9, "development", None)
    lone["merge_state"] = "BEHIND"  # the repo requires up to date
    assert mark_chains([lone])[0]["action"] == "update"
    assert row_hint(dict(tree[1], action="wait"), False) == ("w", "watch")
    assert row_hint(dict(tree[1], action="wait"), True) == (keycap("enter"), "details")
    STACK_LINK = False
    ups = {1: None, 2: 1, 3: 2, 4: 1}
    assert walk_chain(2, lambda n: (ups[n], None), lambda n: ([3] if n == 2 else [2] if n == 1 else [], None)) == ([1, 2, 3], None)
    ch, err = walk_chain(3, lambda n: (ups[n], None), lambda n: ([2, 4] if n == 1 else [], None))
    assert ch is None and "linear" in err  # tree: 1 has two open children
    assert walk_chain(1, lambda n: (2, None), lambda n: ([], None))[1] == "chain loops or is too long"
    assert scroll_window(10, 5, 0, 0) == (0, False, True)
    assert scroll_window(10, 5, 0, 4) == (1, True, True)  # markers hide both edge lines
    assert scroll_window(10, 5, 2, 9) == (5, True, False)
    assert scroll_window(4, 5, 0, 3) == (0, False, False)  # everything fits
    import tempfile as _tf
    global CACHE_DIR
    CACHE_DIR, real_dir = _tf.mkdtemp(), CACHE_DIR
    c = {"slug": "o/r", "fragment": FRAGMENT_SHA, "states": {},
         "nodes": {"1": {"updatedAt": iso_days_ago(1)}, "2": {"updatedAt": iso_days_ago(40)}}}
    save_cache(c)
    assert list(load_cache("o/r")["nodes"]) == ["1"]  # older than CACHE_DAYS: pruned
    assert load_cache("o/other") is None  # file per slug
    c["fragment"] = "old"
    save_cache(c)
    assert load_cache("o/r") is None  # other query shape: ignored, full sync
    clear_cache()
    assert os.listdir(CACHE_DIR) == []
    CACHE_DIR = real_dir
    sp = _tf.mktemp(suffix=".json")
    save_state(sp, {"window": "day", "waiting": [["be", 7]]})
    st = load_state(sp)
    assert st["window"] == "day" and st["waiting"] == [["be", 7]], st
    os.unlink(sp)
    assert load_state("/nonexistent/state.json") == {}
    fr = {"number": 14135, "branch": "feat/ABC-142", "title": "Export the monthly Widget report"}
    assert fuzzy_match("142", fr) and fuzzy_match("abc142", fr) and fuzzy_match("ABC-142", fr)
    assert fuzzy_match("14135", fr) and fuzzy_match("widget", fr)
    assert fuzzy_match("14", fr) and fuzzy_match("ABC-14", fr)  # short = prefix
    assert fuzzy_match("1", fr) and fuzzy_match("ab", fr)       # never blank early
    assert not fuzzy_match("xyz9", fr)
    assert highlight_segs([("feat/ABC-142 x", "gray")], match_pattern("142")) == \
        [("feat/", "gray"), ("ABC-142", "hl"), (" x", "gray")]
    assert match_pattern("widget").search("a Widget chat")
    f2 = {"number": 14116, "branch": "feat/ABC-161", "title": "ABC-161 Unlock"}
    assert not fuzzy_match("116", f2)  # 3+ digits: exact ticket, no #14116 bleed
    assert fuzzy_match("161", f2) and fuzzy_match("14116", f2) and fuzzy_match("11", f2) is False
    f3 = {"number": 9, "branch": "feat/ABC-1160", "title": "x"}
    assert not fuzzy_match("ABC-116", f3)      # no prefix bleed into ABC-1160
    assert fuzzy_score("14135", fr) > fuzzy_score("142", fr) > fuzzy_score("14", fr)
    cfg = parse_config("# c\nrefresh: 60\nrepos:\n  - name: be\n    url: 'https://github.com/o/r'\nauthors:\n  - name: m\n    tag: mf\n")
    assert cfg["repos"] == [{"name": "be", "url": "https://github.com/o/r"}], cfg
    assert cfg["refresh"] == "60", cfg
    assert repo_slug("https://github.com/o/r.git") == "o/r"
    r2 = build_rows({"name": "be", "icon": "nodejs"}, [node], {}, True)[0]
    assert r2["repo_icon"] == REPO_ICONS["nodejs"], r2
    import tempfile
    with tempfile.NamedTemporaryFile("w", suffix=".yaml", delete=False) as f:
        f.write("refresh: 300\nrepos:\n  - name: XX\n    url: https://github.com/o/x\nauthors:\n  - name: m\n    tag: mf\n# tail comment\n")
    write_authors(f.name, [{"name": "M", "tag": "mfu", "me": "true"},
                           {"name": "A", "tag": "aaa"}])
    cfga = parse_config(open(f.name).read())
    assert cfga["authors"] == [{"name": "M", "tag": "mfu", "me": "true"},
                               {"name": "A", "tag": "aaa"}], cfga
    assert me_tag(cfga) == "mfu"
    write_config_key(f.name, "refresh", "120")
    write_config_key(f.name, "restore_filters", "false")
    cfgk = parse_config(open(f.name).read())
    assert cfgk["refresh"] == "120" and cfgk["restore_filters"] == "false", cfgk
    assert cfgk["repos"], cfgk  # rest of the file preserved
    write_repos(f.name, [{"name": "FE", "url": "https://github.com/o/fe", "icon": "react"}])
    cfg2 = parse_config(open(f.name).read())
    assert cfg2["repos"] == [{"name": "FE", "url": "https://github.com/o/fe", "icon": "react"}], cfg2
    assert cfg2["authors"][0]["tag"] == "mfu" and cfg2["refresh"] == "120", cfg2
    os.unlink(f.name)
    pa = {"repo": "be", "branch": "b1", "base": "development"}
    ch = {"repo": "be", "branch": "b2", "base": "b1"}
    ch2 = {"repo": "be", "branch": "b3", "base": "b2"}
    solo = {"repo": "be", "branch": "b9", "base": "development"}
    ordered, marks = stack_order([solo, pa, ch2, ch])
    assert ordered == [solo, pa, ch, ch2], ordered
    assert marks == ["", "▪", "├", "└"], marks
    print("selftest OK")


def main():
    p = argparse.ArgumentParser(
        prog="prx",
        description="TUI for open GitHub PRs across configured repos and authors. "
                    "Shows PR number, status (draft/open/merged/closed), review "
                    "(pending/reviewed/changes), CI (GREEN/YELLOW/RED), and action "
                    "(ready/merge/conflict/blocked). Uses the gh CLI for auth and API access.",
        epilog="Config (YAML, default ~/.config/prx/prx.yaml):\n"
               "  repos:\n    - name: backend\n      url: https://github.com/org/backend\n"
               "  authors:\n    - name: robin\n      tag: robin-gh-login\n\n"
               "Optional top-level keys (TUI only): refresh: 300 (auto-refresh seconds),\n"
               "refresh_waiting: 30 (fast refresh for rows marked waiting with 'w').\n"
               "If authors are configured, only their PRs are shown (override with --all).\n"
               "See prx(1) for full details.",
        formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--config", default=CONFIG_DEFAULT, help="config file path")
    p.add_argument("--plain", action="store_true", help="print table to stdout, no TUI (for scripts/agents)")
    p.add_argument("--json", action="store_true", help="print PRs as JSON to stdout, no TUI")
    p.add_argument("--all", action="store_true", help="show PRs from all authors, not just configured ones")
    p.add_argument("--state", choices=STATE_FILTERS, default="all",
                   help="state filter for --plain/--json output (TUI: cycle with s; default: all)")
    p.add_argument("--author", metavar="NAME",
                   help="only PRs by this author (short name or GitHub login) in --plain/--json output "
                        "(TUI: cycle with a)")
    p.add_argument("--window", choices=WINDOWS, default="week",
                   help="time window: only PRs updated in the last day/week/month, "
                        "1/7/30 days from now (TUI: cycle with l; default: week)")
    p.add_argument("--by", choices=SORTS, default="stack",
                   help="sort for --plain output; 'stack' = repo sort with stacked PRs grouped, "
                        "'change' = last change, newest first "
                        "(TUI: cycle with b; default: stack)")
    p.add_argument("--refresh", type=int, metavar="SEC",
                   help="TUI auto-refresh interval in seconds, 0 disables (default: config 'refresh' key, else 300)")
    p.add_argument("--clear-cache", action="store_true",
                   help=f"delete the TUI's PR cache ({CACHE_DIR}) and exit")
    p.add_argument("--selftest", action="store_true", help=argparse.SUPPRESS)
    args = p.parse_args()

    if args.selftest:
        selftest()
        return
    if args.clear_cache:
        clear_cache()
        return
    try:
        with open(args.config) as f:
            cfg = parse_config(f.read())
    except FileNotFoundError:
        sys.exit(f"prx: config not found: {args.config} (see prx --help for format)")
    if not cfg["repos"]:
        sys.exit("prx: no repos configured")

    global STACK_LINK
    STACK_LINK = gh_stack_installed()
    if args.json or args.plain:
        rows, errors = gather(cfg, args.all)
        rows = filter_rows(rows, args.state, args.window)
        if args.author:
            rows = [r for r in rows if args.author in (r["author"], r["login"])]
        if args.json:
            print(json.dumps({"prs": rows, "errors": errors}, indent=2))
        else:
            print_plain(rows, errors, args.by)
        if errors:
            sys.exit(1)
    else:
        os.environ.setdefault("ESCDELAY", "25")  # snappy Esc, arrows still work via keypad
        refresh_s = args.refresh if args.refresh is not None else int(cfg.get("refresh", 300) or 0)
        wait_s = int(cfg.get("refresh_waiting", 30) or 0)
        try:
            curses.wrapper(tui, cfg, args.config, args.all, refresh_s, wait_s)
        except KeyboardInterrupt:
            pass


if __name__ == "__main__":
    main()
