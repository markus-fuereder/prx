STACK_LINK = False  # gh-stack installed: plain chains get `stack` (set once in main)
M_ACTIONS = ("merge", "land", "stack", "update", "rerun")  # actions M acts on

CHILDREN_QUERY = """
query($owner:String!,$name:String!,$base:String!){
  repository(owner:$owner,name:$name){
    pullRequests(baseRefName:$base, states:[OPEN], first:3){nodes{number}}}
}
"""


def fetch_children(owner, name, branch):
    """Open PR numbers based on `branch`, or (None, err)."""
    out = gh_read(["api", "graphql", "-f", f"query={CHILDREN_QUERY}", "-f", f"owner={owner}",
                   "-f", f"name={name}", "-f", f"base={branch}"])
    if out.returncode != 0:
        return None, gh_err(out)
    nodes = json.loads(out.stdout)["data"]["repository"]["pullRequests"]["nodes"]
    return [n["number"] for n in nodes], None


def walk_chain(number, parent_of, children_of, limit=20):
    """Live plain chain through PR `number`, bottom to top: down through each
    PR's parent, then up through children. Returns (numbers, err); a PR with
    two open children is a tree, which a stack can't hold."""
    bottom, seen = number, {number}
    while True:
        up, err = parent_of(bottom)
        if err:
            return None, err
        if up is None:
            break
        if up in seen or len(seen) >= limit:
            return None, "chain loops or is too long"
        bottom = up
        seen.add(up)
    chain = [bottom]
    while True:
        kids, err = children_of(chain[-1])
        if err:
            return None, err
        if len(kids) > 1:
            return None, f"#{chain[-1]} has {len(kids)} open PRs on it — a stack must be linear"
        if not kids:
            return chain, None
        if kids[0] in chain or len(chain) >= limit:
            return None, "chain loops or is too long"
        chain.append(kids[0])


def linkable(row):
    """In a plain chain gh stack link can take: open, not a native stack, not
    a tree, with a parent PR or open PRs on its branch."""
    return (STACK_LINK and row["status"] in ("open", "draft") and not row.get("stack")
            and not row.get("tree") and bool(row.get("parent_pr") or row.get("kids")))


def fetch_behind(owner, name, nodes):
    """Set node["_behind"]: commits on its base branch its head lacks, from one
    aliased compare request per 100 open same-repo PRs. Nodes the answer
    misses get None; a failed request leaves the old counts."""
    todo = [n for n in nodes if n.get("state") == "OPEN" and not n.get("isCrossRepository")]
    for i in range(0, len(todo), 100):
        chunk = todo[i:i + 100]
        parts = " ".join(
            f'p{n["number"]}:ref(qualifiedName:{json.dumps("refs/heads/" + n["baseRefName"])})'
            f'{{compare(headRef:{json.dumps("refs/heads/" + n["headRefName"])}){{behindBy}}}}'
            for n in chunk)
        out = gh_read(["api", "graphql", "-f", "query={repository(owner:%s,name:%s){%s}}"
                       % (json.dumps(owner), json.dumps(name), parts)])
        try:  # a deleted head branch errors per alias, the rest still answers
            data = json.loads(out.stdout)["data"]["repository"]
        except (ValueError, KeyError, TypeError):
            continue
        for n in chunk:
            n["_behind"] = (((data or {}).get(f'p{n["number"]}') or {}).get("compare") or {}).get("behindBy")


def carry_behind(cached, nodes):
    """Keep the last known behind count on nodes from a sync or refresh until
    the next compare (same head commit only)."""
    for n in nodes:
        old = cached.get(str(n["number"]))
        if old and "_behind" in old and "_behind" not in n and old.get("headRefOid") == n.get("headRefOid"):
            n["_behind"] = old["_behind"]


def fix_steps(stack_no, head, base):
    """Shell steps to resolve a merge conflict locally (prx can't): gh stack
    for a native stack, a plain rebase otherwise. `#` lines are comments."""
    if stack_no:
        return [f"gh stack checkout {stack_no}", "gh stack rebase",
                "# fix the conflicts, then: gh stack rebase --continue", "gh stack push"]
    return ["git fetch origin", f"git switch {head}", f"git rebase origin/{base}",
            "# fix the conflicts, then: git rebase --continue", "git push --force-with-lease"]


def live_chain(owner, name, number):
    """walk_chain on GitHub: (numbers bottom to top, {number: fresh node}, err)."""
    nodes = {}

    def node_of(n):
        if n not in nodes:
            nd, err = fetch_pr_node(owner, name, n)
            if err or not nd:
                return None, err or f"#{n} not found"
            nodes[n] = nd
        return nodes[n], None

    def parent_of(n):
        nd, err = node_of(n)
        if err:
            return None, err
        up = ((nd.get("baseRef") or {}).get("associatedPullRequests") or {}).get("nodes")
        return (up[0]["number"] if up else None), None

    def children_of(n):
        nd, err = node_of(n)
        return (None, err) if err else fetch_children(owner, name, nd["headRefName"])

    chain, err = walk_chain(number, parent_of, children_of)
    if not err:
        for n in chain:  # children come as numbers only: fetch those nodes too
            _, err = node_of(n)
            if err:
                break
    return (None, None, err) if err else (chain, nodes, None)


def mark_chains(rows):
    """Give each row `kids` (open PRs based on its branch) and `tree` (it or a
    sibling forks the chain, so no stack), then recompute its action, so the
    bottom of a plain chain knows it is one. `m` is what M does on the row:
    merge/land/stack/update from the action, else stack on any linkable row,
    else update when its chain is behind. `drift` (a layer behind its parent,
    or BEHIND) and `upd` (anything behind) cover the whole chain, and neither
    is set while a layer conflicts: GitHub would refuse the update."""
    kids = {}
    for r in rows:
        if r["status"] in ("open", "draft"):
            kids.setdefault((r["repo"], r["base"]), []).append(r["number"])
    for r in rows:
        r["kids"] = kids.get((r["repo"], r["branch"]), [])
        r["tree"] = len(r["kids"]) > 1 or bool(
            r.get("parent_pr") and len(kids.get((r["repo"], r["base"]), [])) > 1)
    # chain groups (plain or native, by base branch): drift anywhere marks all
    live = [r for r in rows if r["status"] in ("open", "draft")]
    by_head = {(r["repo"], r["branch"]): r for r in live}

    def root(r):
        seen = {id(r)}
        while (p := by_head.get((r["repo"], r["base"]))) is not None and id(p) not in seen:
            seen.add(id(p))
            r = p
        return r
    groups = {}
    for r in live:
        groups.setdefault(id(root(r)), []).append(r)
    for r in rows:
        r["drift"] = r["upd"] = False
    for g in groups.values():
        if any(x["mergeable"] == "CONFLICTING" for x in g):
            continue  # the update would be refused: offer it nowhere
        # drift: behind its parent PR's branch, or BEHIND (the repo requires up to date)
        drift = any(x["merge_state"] == "BEHIND" or (x.get("parent_pr") and (x.get("behind") or 0) > 0)
                    for x in g)
        behind = drift or any((x.get("behind") or 0) > 0 for x in g)
        for x in g:
            x["drift"], x["upd"] = drift, behind
    for r in rows:
        r["action"] = action_of(r)
        r["m"] = (r["action"] if r["action"] in M_ACTIONS
                  else "stack" if linkable(r) else "update" if r["upd"] else None)
    return rows


def row_hint(row, watched):
    """(key, label) for the footer's right end: the most practical key for
    the selected row. M when it acts, w while CI runs unwatched, else details."""
    if row.get("m"):
        return "M", row["m"]
    if row["action"] == "wait" and not watched:
        return "w", "watch"
    return keycap("enter"), "details"


def copy_text(text):
    """Put text on the system clipboard. False when no clipboard tool exists."""
    for cmd in (["pbcopy"], ["wl-copy"], ["xclip", "-selection", "clipboard"]):
        try:
            if subprocess.run(cmd, input=text, text=True).returncode == 0:
                return True
        except OSError:
            continue
    return False


def write_section(path, section, block):
    """Rewrite one list section of the config file in place, keep the rest."""
    lines = open(path).read().splitlines(True)
    out, i, done = [], 0, False
    while i < len(lines):
        if not done and lines[i].split("#")[0].rstrip() == f"{section}:":
            out += block
            i += 1
            while i < len(lines) and lines[i].startswith(" ") and lines[i].strip():
                i += 1
            done = True
        else:
            out.append(lines[i])
            i += 1
    if not done:
        out += block
    open(path, "w").write("".join(out))


def write_repos(path, repos):
    block = ["repos:\n"]
    for r in repos:
        block.append(f"  - name: {r['name']}\n")
        block.append(f"    url: {r['url']}\n")
        if r.get("icon"):
            block.append(f"    icon: {r['icon']}\n")
    write_section(path, "repos", block)


def write_authors(path, authors):
    block = ["authors:\n"]
    for a in authors:
        block.append(f"  - name: {a['name']}\n")
        block.append(f"    tag: {a['tag']}\n")
        if str(a.get("me")).lower() == "true":
            block.append("    me: true\n")
    write_section(path, "authors", block)


def fetch_pr(repo, number):
    return fetch_pr_node(*repo_slug(repo["url"]).split("/"), number)


def fetch_pr_node(owner, name, number):
    out = gh_read(["api", "graphql", "-f", f"query={PR_QUERY}", "-f", f"owner={owner}",
                   "-f", f"name={name}", "-F", f"number={number}"])
    if out.returncode != 0:
        return None, gh_err(out)
    return json.loads(out.stdout)["data"]["repository"]["pullRequest"], None


def fetch_repo(repo):
    owner, name = repo_slug(repo["url"]).split("/")
    cutoff = iso_days_ago(max(WINDOW_DAYS.values()))
    nodes = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=3) as pool:
        results = pool.map(lambda s: fetch_state(owner, name, s, cutoff),
                           ("OPEN", "MERGED", "CLOSED"))
    for ns, err in results:
        if err:
            return repo, None, err
        nodes += ns
    fetch_behind(owner, name, nodes)
    return repo, nodes, None


def classify(node):
    """Map one GraphQL PR node to a display row dict."""
    state = node["state"]
    status = ("draft" if node["isDraft"] else state.lower()) if state == "OPEN" else state.lower()
    decision = node.get("reviewDecision")
    review = {"APPROVED": "reviewed", "CHANGES_REQUESTED": "changes"}.get(decision, "pending")
    commits = node["commits"]["nodes"]
    rollup = commits[0]["commit"]["statusCheckRollup"] if commits else None
    ci, (passed, failed, running, queued, canceled) = ci_of(rollup)
    threads = node.get("reviewThreads") or {}
    merge_state = node.get("mergeStateStatus")
    repo = node.get("repository") or {}
    parent = ((node.get("baseRef") or {}).get("associatedPullRequests") or {}).get("nodes")
    reviewers = []
    for rv in node.get("latestOpinionatedReviews", {}).get("nodes", []):
        st = {"APPROVED": "approved", "CHANGES_REQUESTED": "changes"}.get(rv["state"], "pending")
        reviewers.append({"login": (rv.get("author") or {}).get("login", "?"), "state": st})
    team_requests = 0
    for rq in node.get("reviewRequests", {}).get("nodes", []):
        who = rq.get("requestedReviewer") or {}
        if who.get("login"):
            reviewers.append({"login": who["login"], "state": "pending"})
        else:  # a Team: naming it needs the read:org scope, so just count
            team_requests += 1
    if team_requests:
        label = "team" if team_requests == 1 else f"team×{team_requests}"
        reviewers.append({"login": label, "state": "pending", "team": True})
    return {
        "number": node["number"], "title": node["title"], "url": node["url"],
        "login": (node.get("author") or {}).get("login", "?"),
        "branch": node.get("headRefName", ""),
        "base": node.get("baseRefName", ""),
        "updated": node.get("updatedAt", ""),
        "created": node.get("createdAt", ""),
        "reviewers": reviewers,
        "status": status, "review": review, "decision": decision,
        "ci": ci, "mergeable": node.get("mergeable"), "merge_state": merge_state,
        "checks": [passed, failed, running, queued, canceled],
        "rerun": rerun_ids(rollup) if ci == "CANCELLED" else {},
        # review threads: [open, resolved, total]; open counts the first 100
        "comments": [sum(not t["isResolved"] for t in threads.get("nodes", [])),
                     threads.get("totalCount", 0) - sum(not t["isResolved"] for t in threads.get("nodes", [])),
                     threads.get("totalCount", 0)],
        "head_oid": node.get("headRefOid", ""),
        "behind": node.get("_behind"),
        "merge_queue": bool(node.get("isMergeQueueEnabled")),
        "default_branch": (repo.get("defaultBranchRef") or {}).get("name"),
        "method": repo.get("viewerDefaultMergeMethod") or "SQUASH",
        "delete_branch": bool(repo.get("deleteBranchOnMerge")),
        "parent_pr": parent[0]["number"] if parent else None,
        "stack": stack_of(node),
    }


def newest_checks(rollup):
    """The head commit's checks that count. Checks that ran again on the same
    commit (a re-run, a label event, a run canceled by a newer push of the
    same workflow) count only with the newest: per Actions workflow, only its
    newest run's checks (a run canceled early can carry unexpanded matrix
    names like `Tests (${{ matrix.x }})`, so names alone don't match); then
    per check name, its newest start. That is what GitHub's PR page shows."""
    nodes = ((rollup or {}).get("contexts") or {}).get("nodes", [])

    def run_of(c):
        r = (c.get("checkSuite") or {}).get("workflowRun") or {}
        return (r.get("workflow") or {}).get("name", ""), r.get("runNumber")
    latest = {}
    for c in nodes:
        wf, num = run_of(c)
        if wf and num is not None:
            latest[wf] = max(latest.get(wf, num), num)
    newest, rest = {}, []
    for c in nodes:
        wf, num = run_of(c)
        if wf and num is not None and num < latest[wf]:
            continue  # an older run of this workflow: superseded
        if c.get("__typename") == "CheckRun" and c.get("name"):
            k = (wf, c["name"])
            if k not in newest or (c.get("startedAt") or "") > (newest[k].get("startedAt") or ""):
                newest[k] = c
        else:
            rest.append(c)
    return rest + list(newest.values())


def rerun_ids(rollup):
    """{workflow run id: workflow name} for runs whose counting checks were
    canceled — what gh run rerun --failed restarts."""
    out = {}
    for c in newest_checks(rollup):
        r = (c.get("checkSuite") or {}).get("workflowRun") or {}
        if c.get("conclusion") == "CANCELLED" and r.get("databaseId"):
            out[r["databaseId"]] = (r.get("workflow") or {}).get("name", "?")
    return out


def ci_of(rollup):
    """(GREEN/YELLOW/RED/CANCELLED/-, [passed, failed, running, queued,
    canceled]) for one head commit, from newest_checks. A canceled run is
    no result, not a failure: CANCELLED (rerun) unless something failed or
    still runs. GitHub's own rollup state counts stale and canceled runs as
    failures, so it is only the fallback when no contexts came back."""
    nodes = ((rollup or {}).get("contexts") or {}).get("nodes", [])
    passed = failed = running = queued = canceled = 0
    for c in newest_checks(rollup):
        if c.get("__typename") == "CheckRun":
            if c.get("status") == "COMPLETED":
                if c.get("conclusion") in ("SUCCESS", "NEUTRAL", "SKIPPED"):
                    passed += 1
                elif c.get("conclusion") == "CANCELLED":
                    canceled += 1
                else:
                    failed += 1
            elif c.get("status") == "IN_PROGRESS":
                running += 1
            else:
                queued += 1
        else:
            st = c.get("state")
            passed += st == "SUCCESS"
            failed += st in ("FAILURE", "ERROR")
            queued += st not in ("SUCCESS", "FAILURE", "ERROR")
    state = (rollup or {}).get("state")
    if not nodes:
        ci = {"SUCCESS": "GREEN", "FAILURE": "RED", "ERROR": "RED",
              "PENDING": "YELLOW", "EXPECTED": "YELLOW"}.get(state, "-")
    else:  # EXPECTED: a required status hasn't reported yet
        ci = ("RED" if failed else "YELLOW" if running or queued or state == "EXPECTED"
              else "CANCELLED" if canceled else "GREEN" if passed else "-")
    return ci, [passed, failed, running, queued, canceled]


def layer_ok(pr):
    """One native-stack layer is ready to land: open, not draft, no conflict,
    approved, CI green (or no checks), and GitHub doesn't report it BLOCKED,
    DIRTY or DRAFT — a stack merge applies the stack base's rules to every
    layer, so a layer's BLOCKED (e.g. a code-owner review its own files need)
    blocks the stack even when reviewDecision, computed against the layer's
    unprotected base branch, says nothing. UNKNOWN passes: GitHub computes it
    lazily. The bottom must also be CLEAN."""
    commits = pr["commits"]["nodes"]
    rollup = commits[0]["commit"]["statusCheckRollup"] if commits else None
    approved = pr.get("reviewDecision") == "APPROVED" or (
        pr.get("reviewDecision") is None and any(
            rv["state"] == "APPROVED" for rv in pr["latestOpinionatedReviews"]["nodes"]))
    return (pr["state"] == "OPEN" and not pr["isDraft"] and approved
            and pr.get("mergeable") != "CONFLICTING"
            and pr.get("mergeStateStatus") not in ("BLOCKED", "DIRTY", "DRAFT")
            and ci_of(rollup)[0] in ("GREEN", "-"))


def stack_of(node):
    """Native GitHub stack info, None when the PR isn't in one. `ready`: every
    unmerged layer of the whole stack passes layer_ok, and the bottom one is
    CLEAN — land merges them all in one go."""
    st, entry = node.get("stack"), node.get("stackEntry")
    if not st or not entry:
        return None
    layers = sorted((st.get("entries") or {}).get("nodes", []), key=lambda e: e["position"])
    # positions stay put after merges: the bottom is the lowest unmerged layer
    open_ = [e for e in layers if e["pullRequest"]["state"] != "MERGED"]
    ready = (bool(open_) and open_[0]["pullRequest"]["mergeStateStatus"] == "CLEAN"
             and all(layer_ok(e["pullRequest"]) for e in open_))
    return {"number": st["number"], "size": st["size"], "position": entry["position"],
            "ready": ready,
            "layers": [{"number": e["pullRequest"]["number"],
                        "login": (e["pullRequest"].get("author") or {}).get("login", "?")}
                       for e in open_]}


def action_of(row):
    """The next move, first match wins. `review` is viewer-relative (me).
    Draft outranks merge so an approved draft never says merge. Off the
    default branch: land (native stack), hold (plain stack), blocked (other).
    With gh-stack, hold and a plain chain's bottom merge become stack, but only
    for squash/rebase: there a lone merge forces rebases above it."""
    if row["status"] in ("merged", "closed"):
        return "done"
    if any(rv.get("me") and rv["state"] == "pending" for rv in row["reviewers"]):
        return "review"
    if row["mergeable"] == "CONFLICTING":
        return "rebase"
    if row["ci"] == "RED":
        return "fix ci"
    if row["ci"] == "CANCELLED":
        return "rerun"  # CI never finished: nothing to fix, run it again
    if row["review"] == "changes":
        return "address"
    if row["status"] == "draft":
        return "ready"  # a draft's next move: mark it ready for review
    if row.get("drift"):
        return "update"  # its chain is behind what it lands on: update before landing
    approved = row["review"] == "reviewed" or (row["decision"] is None and any(
        rv["state"] == "approved" for rv in row["reviewers"]))
    ready = approved and row["ci"] in ("GREEN", "-")
    off_trunk = row.get("default_branch") and row["base"] != row["default_branch"]
    link = linkable(row) and row["method"].upper() in ("SQUASH", "REBASE")
    if ready and row.get("stack") and row["stack"]["ready"]:
        return "land"  # native stack, every layer ready: any layer lands them all
    if ready and off_trunk:
        if row.get("stack"):
            pass  # a layer of the stack isn't ready yet: no land
        elif row["merge_state"] == "CLEAN":
            if row.get("parent_pr"):
                return "stack" if link else "hold"
            return "blocked"
    elif ready and row["merge_state"] == "CLEAN":
        return "stack" if link and row.get("kids") else "merge"
    if row["ci"] == "YELLOW":
        return "wait"
    return "chase"


def fuzzy_score(q, row):
    """Search PR number, branch, and title; 0 = no match, higher = better.
    Digits bind to the ticket convention: '116' or 'ABC-116' (or 'abc116')
    matches exactly the ABC-116 rows — never ABC-1160 or ABC-161 — or the PR
    number. Short digit queries (under 3) match as prefixes so typing never
    blanks the table. Anything else is a case-insensitive substring match."""
    hay = f"#{row['number']} {row['branch']} {row['title']}".lower()
    q = q.lower().strip()
    if not q:
        return 1
    m = re.fullmatch(r"#?(\d+)", q)
    if m:
        d = m.group(1)
        if str(row["number"]) == d:
            return 4
        if re.search(rf"[a-z]+-{d}(?!\d)", hay):
            return 3
        if len(d) < 3 and re.search(rf"[a-z]+-{d}\d*", hay):
            return 2
        if str(row["number"]).startswith(d):
            return 2 if len(d) >= 3 else 1
        return 0
    m = re.fullmatch(r"([a-z]+)-?(\d+)", q)
    if m:
        prefix, d = m.groups()
        if re.search(rf"\b{prefix}-?{d}(?!\d)", hay):
            return 3
        if len(d) < 3 and re.search(rf"\b{prefix}-?{d}\d*", hay):
            return 2
        return 0
    return 1 if q in hay else 0


def fuzzy_match(q, row):
    return fuzzy_score(q, row) > 0


def match_pattern(q):
    """Regex highlighting what fuzzy_match matched, same length-adaptive rules."""
    q = (q or "").lower().strip()
    if not q:
        return None
    m = re.fullmatch(r"#?(\d+)", q)
    if m:
        d = m.group(1)
        tail = r"(?!\d)" if len(d) >= 3 else r"\d*"
        return re.compile(rf"[a-z]+-{d}{tail}|#{d}\d*", re.IGNORECASE)
    m = re.fullmatch(r"([a-z]+)-?(\d+)", q)
    if m:
        prefix, d = m.groups()
        tail = r"(?!\d)" if len(d) >= 3 else r"\d*"
        return re.compile(rf"\b{prefix}-?{d}{tail}", re.IGNORECASE)
    return re.compile(re.escape(q), re.IGNORECASE)


def highlight_segs(segs, pat):
    """Split segments so pattern matches render in the highlight color."""
    out = []
    for text, clr in segs:
        last = 0
        for m in pat.finditer(text):
            if m.start() > last:
                out.append((text[last:m.start()], clr))
            out.append((m.group(0), "hl"))
            last = m.end()
        if last < len(text):
            out.append((text[last:], clr))
    return out


def load_state(path):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return {}


def save_state(path, data):
    try:
        with open(path, "w") as f:
            json.dump(data, f)
    except OSError:
        pass


CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "prx")
CACHE_DAYS = 30  # = widest window; older nodes are pruned on save
SYNC_MARGIN = 300  # s: watermark sits this far before the sync start (clock skew)


def cache_path(slug):
    return os.path.join(CACHE_DIR, hashlib.sha1(slug.encode()).hexdigest() + ".json")


def load_cache(slug):
    """Restore one repo's cache, or None when missing, broken, or written for
    another query shape (fragment hash) — the caller then does a full sync."""
    c = load_state(cache_path(slug))
    if c.get("slug") != slug or c.get("fragment") != FRAGMENT_SHA:
        return None
    c.setdefault("states", {})
    c.setdefault("nodes", {})
    return c


def save_cache(c):
    """Prune nodes older than CACHE_DAYS, then write atomically (temp + rename)."""
    cutoff = iso_days_ago(CACHE_DAYS)
    c["nodes"] = {k: n for k, n in c["nodes"].items() if n.get("updatedAt", "") >= cutoff}
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        path = cache_path(c["slug"])
        with open(path + ".tmp", "w") as f:
            json.dump(c, f)
        os.replace(path + ".tmp", path)
    except OSError:
        pass  # the cache is disposable: next start just does a full sync


def clear_cache():
    for f in (os.listdir(CACHE_DIR) if os.path.isdir(CACHE_DIR) else []):
        if f.endswith((".json", ".tmp")):
            os.remove(os.path.join(CACHE_DIR, f))


def write_config_key(path, key, value):
    """Set one top-level key in the config file, preserving everything else."""
    lines = open(path).read().splitlines(True)
    out, done = [], False
    for ln in lines:
        bare = ln.split("#")[0]
        if (not done and not ln.startswith((" ", "\t")) and ":" in bare
                and bare.split(":")[0].strip() == key):
            out.append(f"{key}: {value}\n")
            done = True
        else:
            out.append(ln)
    if not done:
        out.insert(0, f"{key}: {value}\n")
    open(path, "w").write("".join(out))


def me_tag(cfg):
    return next((a["tag"] for a in cfg["authors"]
                 if str(a.get("me")).lower() == "true"), None)


def build_rows(repo, nodes, authors, show_all, me=None):
    rows = []
    for node in nodes:
        row = classify(node)
        if not show_all and authors and row["login"] not in authors:
            continue
        row["repo"] = repo["name"]
        row["org"] = repo_slug(repo["url"]).split("/")[0] if repo.get("url") else ""
        icon = repo.get("icon", "")
        row["repo_icon"] = REPO_ICONS.get(icon, icon or "")  # default: oct-repo
        row["author"] = authors.get(row["login"], row["login"])
        row["mine"] = me is not None and row["login"] == me
        for rv in row["reviewers"]:
            rv["name"] = authors.get(rv["login"], rv["login"])
            rv["me"] = me is not None and rv["login"] == me
            rv["known"] = rv["login"] in authors
        row["ext_review"] = bool(authors) and any(
            rv["state"] == "pending" and not rv["known"]
            for rv in row["reviewers"])
        row["action"] = action_of(row)
        rows.append(row)
    return rows


def gather(cfg, show_all):
    authors = {a["tag"]: a["name"] for a in cfg["authors"]}
    me = me_tag(cfg)
    rows, errors = [], []
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        for repo, nodes, err in pool.map(fetch_repo, cfg["repos"]):
            if err:
                errors.append(f"{repo['name']}: {err}")
            else:
                rows += build_rows(repo, nodes, authors, show_all, me)
    return mark_chains(rows), errors


