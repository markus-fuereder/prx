                    safe_add(stdscr, yy, x0 + 2 + len(mk) + 1, rest[:iw],
                             pal["cur" if c == "stackcur" else "label"])
                else:
                    safe_add(stdscr, yy, x0 + 2, t[:iw], pal[c])
            safe_add(stdscr, y0 + mh - 1, x0, "└" + "─" * (mw - 2) + "┘", pal["border"])
            watch_lb = "unwatch" if wkey in waiting else "watch"
            fx2 = x0 + 2
            tags = [(f"{keycap('up_down')}", "move"),
                    (keycap("enter"), "open"), (keycap("space"), "refresh"),
                    ("w", watch_lb)]
            if row.get("m"):
                tags.append(("M", row["m"]))
            if time.time() < toast["until"]:  # a yank note replaces the tags briefly
                draw_tag(stdscr, pal, y0 + mh - 1, fx2, [(f" {toast['text']} ", pal["green"])])
                tags = []
            for kh, lb in tags + ([(keycap("esc"), "close")] if tags else []):
                fx2 = draw_tag(stdscr, pal, y0 + mh - 1, fx2,
                               [(f" {kh} ", pal["value"] | curses.A_BOLD),
                                (f"{lb} ", pal["label"])])
            stdscr.refresh()
            # keep refresh/waiting schedules alive while the card is open
            now = time.time()
            if (auto_on and refresh_s and not state["pending"]
                    and now - state["started"] >= refresh_s):
                start_fetch()
            if wait_s and waiting and now - state["w_started"] >= wait_s:
                start_waiting_fetch()
            k = stdscr.getch()
            if k in (curses.KEY_DOWN, ord("j")):
                idx += 1
            elif k in (curses.KEY_UP, ord("k")):
                idx -= 1
            elif k in (curses.KEY_ENTER, 10, 13):
                webbrowser.open(row["url"])  # stays open
            elif k == ord(" "):
                fetch_waiting_pr(key)
            elif k == ord("w"):
                waiting.symmetric_difference_update({wkey})
                if wkey in waiting:
                    fetch_waiting_pr(wkey)
            elif k == ord("M") and row.get("m"):
                merge_flow(*key)
            elif k in (ord("y"), ord("Y")):
