def make_palette():
    curses.use_default_colors()
    has256 = curses.COLORS >= 256
    defs = {"green": curses.COLOR_GREEN, "yellow": curses.COLOR_YELLOW,
            "red": curses.COLOR_RED, "cyan": curses.COLOR_CYAN,
            "gray": 245 if has256 else curses.COLOR_WHITE,
            "darkgray": 238 if has256 else curses.COLOR_WHITE,
            "purple": 135 if has256 else curses.COLOR_MAGENTA,
            "orange": 208 if has256 else curses.COLOR_YELLOW,
            "blue": 33 if has256 else curses.COLOR_BLUE,
            "white": 231 if has256 else curses.COLOR_WHITE}
    pal = {}
    for i, (name, fg) in enumerate(defs.items(), 1):
        curses.init_pair(i, fg, -1)
        pal[name] = curses.color_pair(i)
    if not has256:
        pal["gray"] |= curses.A_DIM
        pal["darkgray"] |= curses.A_DIM
    # the one pair with a real background: black on gray, for the help flash.
    # 16 is true black; color 0 follows the terminal theme and is often not.
    curses.init_pair(len(defs) + 1, 16 if has256 else curses.COLOR_BLACK,
                     245 if has256 else curses.COLOR_WHITE)
    pal["flash"] = curses.color_pair(len(defs) + 1)
    pal["dim"] = pal["gray"]
    pal["me"] = pal["orange"] | curses.A_BOLD | curses.A_REVERSE  # review action
    pal["mine"] = pal["blue"] | curses.A_BOLD | curses.A_REVERSE  # me in REV
    pal["hl"] = pal["yellow"] | curses.A_BOLD | curses.A_REVERSE
    for role, base in ROLE.items():  # semantic roles alias to base colors
        pal[role] = pal[base]
    pal["cur"] = pal["value"] | curses.A_BOLD  # current item, bold/bright
    return pal


def safe_add(stdscr, y, x, text, attr):
    height, width = stdscr.getmaxyx()
    if y >= height or x >= width:
        return
    try:
        stdscr.addstr(y, x, text[:width - x], attr)
    except curses.error:
        pass  # writing the bottom-right cell always raises after painting


def draw_tag(stdscr, pal, y, x, parts):
    """Label laid over a border line, no caps — the ─ runs separate tags."""
    cx = x
    for text, attr in parts:
        safe_add(stdscr, y, cx, text, attr)
        cx += len(text)
    return cx + 1


def ask_nerd_font(stdscr, pal):
    """First-run prompt: show sample glyphs, let the user confirm they render.
    Returns True (nerd font) / False (ASCII fallbacks)."""
    stdscr.erase()
    h, w = stdscr.getmaxyx()
    mw = max(46, min(64, w - 4))
    y0, x0 = h // 2 - 3, (w - mw) // 2
    lines = [
        "Do these show as icons (not boxes or ??)?",
        "",
        "   󰗡  󰅙  󰊢  󰀄  󰇗  󰓂  󰏫  ",
        "",
        "y = yes, use icons     n = no, use plain text",
    ]
    safe_add(stdscr, y0, x0, "┌" + "─" * (mw - 2) + "┐", pal["gray"])
    for i, t in enumerate(lines):
        safe_add(stdscr, y0 + 1 + i, x0, "│", pal["gray"])
        safe_add(stdscr, y0 + 1 + i, x0 + mw - 1, "│", pal["gray"])
        clr = pal["white"] | curses.A_BOLD if i in (0, 2) else pal["gray"]
        safe_add(stdscr, y0 + 1 + i, x0 + 1, t.center(mw - 2)[:mw - 2], clr)
    safe_add(stdscr, y0 + 1 + len(lines), x0, "└" + "─" * (mw - 2) + "┘", pal["gray"])
    stdscr.refresh()
    while True:
        k = stdscr.getch()
        if k in (ord("n"), ord("N")):
            return False
        if k in (ord("y"), ord("Y"), curses.KEY_ENTER, 10, 13):
            return True


def tui(stdscr, cfg, cfg_path, show_all, refresh_s, wait_s):
    curses.curs_set(0)
    # pop any leftover kitty keyboard-protocol flags (a prior crash could
    # strand them, garbling input); no-op on an empty stack or other terminals
    sys.stdout.write("\x1b[<u")
    sys.stdout.flush()
    stdscr.timeout(100)
    pal = make_palette()
    global NF
    if "nerd_font" in cfg:
        NF = str(cfg.get("nerd_font", "true")).lower() != "false"
    else:  # first run: ask, since font presence can't be probed reliably
        NF = ask_nerd_font(stdscr, pal)
        try:
            write_config_key(cfg_path, "nerd_font", "true" if NF else "false")
        except OSError:
            pass
    by, cursor, top, spin, state_f, window = "stack", 0, 0, 0, "all", "week"
    compact = False  # 'c' toggles; narrow terminals force it
    authors = {a["tag"]: a["name"] for a in cfg["authors"]}
    me = me_tag(cfg)
    author_cycle = [None] + [a["name"] for a in cfg["authors"]]
    author_f = None
    repo_f = None

    def repos_of(org):
        """Repo filter cycle: all repos, or only the org's when one is set."""
        return [None] + [r["name"] for r in cfg["repos"]
                         if not org or repo_slug(r["url"]).split("/")[0] == org]
    org_list = sorted({repo_slug(r["url"]).split("/")[0] for r in cfg["repos"]})
    org_f = None
    waiting = set()  # (repo short name, PR number) on the fast refresh schedule
    auto_on = refresh_s > 0
    last_q = 0.0

    # hydrate last session's filters/waiting (config: restore_filters/restore_waiting)
    state_path = os.path.join(os.path.dirname(cfg_path) or ".", "state.json")
    saved = load_state(state_path)
    if str(cfg.get("restore_filters", "true")).lower() != "false":
        window = saved.get("window") if saved.get("window") in WINDOWS else window
        by = saved.get("by") if saved.get("by") in SORTS else by
        state_f = saved.get("state") if saved.get("state") in STATE_FILTERS else state_f
        org_f = saved.get("org") if saved.get("org") in org_list else None
        repo_f = saved.get("repo") if saved.get("repo") in repos_of(org_f) else None
        author_f = saved.get("author") if saved.get("author") in author_cycle else None
        auto_on = bool(saved.get("auto_on", auto_on))
        compact = bool(saved.get("compact", False))
    if str(cfg.get("restore_waiting", "true")).lower() != "false":
        names = {r["name"] for r in cfg["repos"]}
        waiting = {(rn, n) for rn, n in map(tuple, saved.get("waiting", []))
                   if rn in names}
    last_snap = None
    show_keys = str(cfg.get("show_filter_keys", "false")).lower() == "true"
    peek_until = 0.0  # 'h' held: show trigger keys until repeats stop (~PEEK_HOLD)
    search_q, search_edit = None, False  # "/" fuzzy search over visible rows
    snap_best = False  # jump selection to the best match after a search edit
    state = {"rows": [], "errors": [], "at": None,
             "pending": set(), "started": 0.0,
             "pending_prs": set(), "w_started": 0.0,
             "cover": {"days": 0, "states": set(), "repos": set()}}
    lock = threading.Lock()
    sync_due = None
    caches = {}  # repo name -> cache dict (see load_cache); only the TUI uses it
    cache_lock = threading.Lock()  # own lock: callers may already hold `lock`

    def cache_of(repo):
        """The repo's cache, loaded on first use, so repos added in the
        settings modal (or renamed onto another slug) get one too."""
        slug = repo_slug(repo["url"])
        with cache_lock:
            c = caches.get(repo["name"])
            if c is None or c["slug"] != slug:
                c = caches[repo["name"]] = load_cache(slug) or {
                    "slug": slug, "fragment": FRAGMENT_SHA, "states": {}, "nodes": {}}
            return c

    def restore():
        """Show last session's rows at once; the start-up sync then updates them."""
        rows, newest = [], 0
        for repo in cfg["repos"]:
            c = cache_of(repo)
            rows += build_rows(repo, list(c["nodes"].values()), authors, show_all, me)
            newest = max([newest] + [w.get("at", 0) for w in c["states"].values()])
        state["rows"] = rows
        state["restored"] = newest
    restore()
    widen = True  # scope grew (or first load): show a loading line under the rows
    toast = {"text": "", "until": 0.0}  # short footer note, e.g. after a yank

    def yank(row, what):
        """y copies the PR number, Y the link; the footer confirms."""
        text = f"#{row['number']}" if what == "number" else row["url"]
        ok = copy_text(text)
        toast.update(text=f"copied {text}" if ok else "no clipboard tool found",
                     until=time.time() + 1.5)

    def scope():
        """What the current filters need fetched."""
        days = WINDOW_DAYS[window]
        states = STATES_FOR[state_f]
        repos = [r for r in cfg["repos"]
                 if (not repo_f or r["name"] == repo_f)
                 and (not org_f or repo_slug(r["url"]).split("/")[0] == org_f)]
        return days, states, repos

    def coverage_missing():
        days, states, repos = scope()
        c = state["cover"]
        return (days > c["days"] or not set(states) <= c["states"]
                or not {r["name"] for r in repos} <= c["repos"])

    def start_fetch():
        if state["pending"]:
            return
        days, states, repos = scope()
        state["cover"] = {"days": days, "states": set(states),
                          "repos": {r["name"] for r in repos}}
        state["started"] = time.time()
        state["pending"] = {(r["name"], s) for r in repos for s in states}
        state["errors"] = []
        seen = {r["name"]: set() for r in repos}  # PR numbers fetched this round
        failed = set()
        synced_at = iso_days_ago(SYNC_MARGIN / 86400)  # the next watermark

        def work(repo, st):
            owner, name = repo_slug(repo["url"]).split("/")
            cutoff, after, err = iso_days_ago(days), None, None
            c = cache_of(repo)
            mark = c["states"].get(st)
            # delta sync: merged PRs are final, so MERGED stops at the watermark,
            # but only inside the range a previous sync covered; else full sync
            delta = st == "MERGED" and mark and mark["covered_since"] <= cutoff
            stop_at = max(mark["watermark"], cutoff) if delta else cutoff
            got = set()
            try:
                for _ in range(MAX_PAGES):
                    nodes, after, err = fetch_page(owner, name, st, after)
                    if err:
                        break
                    carry_behind(c["nodes"], nodes)
                    new = build_rows(repo, nodes, authors, show_all, me)
                    with lock:  # upsert this page's rows immediately
                        got.update(n["number"] for n in nodes)
                        c["nodes"].update((str(n["number"]), n) for n in nodes)
                        nums = {r["number"] for r in new}
                        state["rows"] = [r for r in state["rows"]
                                         if r["repo"] != repo["name"] or r["number"] not in nums] + new
                    if not after or (nodes and nodes[-1]["updatedAt"] < stop_at):
                        break
                if st == "OPEN" and not err:  # behind counts for every open PR
                    opens = [n for n in c["nodes"].values() if n["number"] in got]
                    fetch_behind(owner, name, opens)
                    new = build_rows(repo, opens, authors, show_all, me)
                    with lock:
                        nums = {r["number"] for r in new}
                        state["rows"] = [r for r in state["rows"]
                                         if r["repo"] != repo["name"] or r["number"] not in nums] + new
            except Exception as e:
                err = str(e)
            with lock:
                if delta:  # unchanged merged PRs came from the cache: still valid
                    got.update(n["number"] for n in c["nodes"].values()
                               if n["state"] == st and n["updatedAt"] >= cutoff)
                elif not err:  # full sync: cached PRs of this state it didn't return are gone
                    c["nodes"] = {k: n for k, n in c["nodes"].items()
                                  if n["state"] != st or n["updatedAt"] < cutoff
                                  or n["number"] in got}
                seen[repo["name"]].update(got)
                if not err:  # a failed sync advances neither timestamp
                    c["states"][st] = {"watermark": synced_at, "covered_since":
                                       mark["covered_since"] if delta else cutoff,
                                       "at": time.time()}  # real time, for "restored … ago"
                if err:
                    state["errors"].append(f"{repo['name']}: {err}")
                    failed.add(repo["name"])
                state["pending"].discard((repo["name"], st))
                repo_done = not any(rn == repo["name"] for rn, _ in state["pending"])
                if repo_done:
                    save_cache(c)
                if repo_done and repo["name"] not in failed:
                    # drop rows that vanished from GitHub this round (fetched states only)
                    state["rows"] = [r for r in state["rows"] if r["repo"] != repo["name"]
                                     or STATUS_GROUP[r["status"]] not in states
                                     or r["number"] in seen[repo["name"]]]
                if not state["pending"]:
                    state["at"] = time.time()
        for repo in repos:
            for st in states:
                threading.Thread(target=work, args=(repo, st), daemon=True).start()

