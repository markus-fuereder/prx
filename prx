def scroll_window(n, body, top, sel):
    """Scroll so line `sel` stays visible when the first/last visible line
    turns into a "more" marker. Returns (top, marker up, marker down)."""
    if body < 3:  # too short for markers: plain scrolling
        top = min(max(top, sel - body + 1), sel)
        return max(0, top), False, False
    top = max(0, min(top, sel))
    while True:
        up, down = top > 0, top + body < n
        if sel < top + up:
            top -= 1
        elif sel > top + body - 1 - down:
            top += 1
        else:
            return top, up, down


SORTS = ("stack", "repo", "author", "change")


def sort_rows(rows, by):
    if by == "change":  # last change, newest first
        return sorted(rows, key=lambda r: r["updated"], reverse=True)
    rows = sorted(rows, key=lambda r: r["updated"], reverse=True)  # newest first
    return sorted(rows, key=lambda r: (r[by], r["repo"]))  # stable: keeps recency order


def stack_order(rows):
    """Group stacked PRs (base branch = another visible row's head branch) under
    their parent. Returns (ordered rows, marker per row index): parent "▪",
    descendants "├", last one "└" — a flat rail regardless of depth."""
    by_head = {(r["repo"], r["branch"]): r for r in rows}
    children, roots = {}, []
    for r in rows:
        parent = by_head.get((r["repo"], r["base"]))
        if parent is not None and parent is not r:
            children.setdefault(id(parent), []).append(r)
        else:
            roots.append(r)
    ordered, markers, seen = [], [], set()

    def emit(r):
        if id(r) in seen:  # cycle guard
            return 0
        seen.add(id(r))
        ordered.append(r)
        markers.append("")
        n = 1
        for c in children.get(id(r), []):
            n += emit(c)
        return n

    for root in roots:
        if id(root) in seen:
            continue
        start = len(ordered)
        n = emit(root)
        if n > 1:
            markers[start] = "▪"
            for i in range(start + 1, start + n):
                markers[i] = "├"
            markers[start + n - 1] = "└"
    return ordered, markers


PLAIN_RAIL = {"▪": "▫", "├": "┆", "└": "╰"}


def rail_mark(mark, row):
    """Stack rail glyph and color: native stacks solid purple, plain chains
    (linkable with gh stack link) dashed gray."""
    return (mark, "purple") if row.get("stack") else (PLAIN_RAIL.get(mark, mark), "gray")


def print_plain(rows, errors, by):
    print(PLAIN_HEADER)
