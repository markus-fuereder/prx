            if meta[n]["icon"]:
                entry["icon"] = meta[n]["icon"]
            kept.append(entry)
        cfg["repos"] = kept
        write_repos(cfg_path, kept)
        repo_f = None
        org_list[:] = sorted({repo_slug(r["url"]).split("/")[0] for r in kept})
        if org_f not in org_list:  # its last repo was just removed
            org_f = None
        state["cover"] = {"days": 0, "states": set(), "repos": set()}
        sync_due = time.time()  # sync on next tick

    def fetch_waiting_pr(key):
        if any(rn == key[0] for rn, _ in state["pending"]) or key in state["pending_prs"]:
            return
        state["pending_prs"].add(key)

        def work():
            repo = next(r for r in cfg["repos"] if r["name"] == key[0])
            try:
                node, err = fetch_pr(repo, key[1])
                if node and not err:
                    fetch_behind(*repo_slug(repo["url"]).split("/"), [node])
            except Exception as e:
                node, err = None, str(e)
            with lock:
                if node and not err:
                    cache_of(repo)["nodes"][str(node["number"])] = node  # saved on next sync
                    row = build_rows(repo, [node], authors, True, me)[0]
                    state["rows"] = [r for r in state["rows"]
                                     if (r["repo"], r["number"]) != key] + [row]
                state["pending_prs"].discard(key)
        threading.Thread(target=work, daemon=True).start()

    def modal_box(title, lines, keys):
        """Dialog: lines are lists of (text, attr) segments ([] = blank line),
        keys are (keycap, label) tags on the bottom border. Returns the key."""
        height, width = stdscr.getmaxyx()
        pad = not (compact or width < COMPACT_BELOW)
        mpad = 1 if pad else 0
        mw = max(50, min(76, width - 4))
        mh = min(len(lines) + 2 + 2 * mpad, height - 2)
        y0, x0 = (height - mh) // 2, (width - mw) // 2
        stdscr.erase()
        safe_add(stdscr, y0, x0, "┌" + "─" * (mw - 2) + "┐", pal["border"])
        draw_tag(stdscr, pal, y0, x0 + 2, [(f" {title} ", pal["value"] | curses.A_BOLD)])
        for r in range(y0 + 1, y0 + mh - 1):
            safe_add(stdscr, r, x0, "│", pal["border"])
            safe_add(stdscr, r, x0 + mw - 1, "│", pal["border"])
        for i, segs in enumerate(lines[:mh - 2 - 2 * mpad]):
            x = x0 + 2
            for text, attr in segs:
                text = text[:max(0, x0 + mw - 2 - x)]
                safe_add(stdscr, y0 + 1 + mpad + i, x, text, attr)
                x += len(text)
        safe_add(stdscr, y0 + mh - 1, x0, "└" + "─" * (mw - 2) + "┘", pal["border"])
        fx = x0 + 2
        for kh, lb in keys:
            fx = draw_tag(stdscr, pal, y0 + mh - 1, fx,
                          [(f" {kh} ", pal["value"] | curses.A_BOLD), (f"{lb} ", pal["label"])])
        stdscr.refresh()
        while True:
            k = stdscr.getch()
            if k != -1:
                return k

    def stack_flow(repo, slug, number, offer_merge=False, offer_update=False):
        """Link the live plain chain through `number` into a native stack:
        walk it on GitHub, confirm with y, then gh stack link (PR URLs, --base
        pinned to the bottom's base so link never retargets it)."""
        owner, name = slug.split("/")
        modal_msg(f"walking the chain of #{number}...")
        chain, nodes, err = live_chain(owner, name, number)
        if err:
            modal_msg(f"can't stack: {err}", wait_key=True)
            return
        if len(chain) < 2:
            modal_msg(f"#{number} is no longer part of a chain", wait_key=True)
            return
        val, lab, warn = pal["value"], pal["label"], pal["orange"]
        base = nodes[chain[0]]["baseRefName"]
        lines = [[("link ", lab), (f"{len(chain)} PRs", val), (" onto ", lab), (base, val),
                  (", bottom to top:", lab)]]
        for n in chain:
            nd = nodes[n]
            lines.append([(f"  #{n} ", val), (f"{nd['baseRefName']} ← {nd['headRefName']}", lab)])
        in_stack = [n for n in chain if nodes[n].get("stack")]
        if in_stack:
            lines.append([("already in a stack: " + " ".join(f"#{n}" for n in in_stack)
                           + " — link adds the rest to it", lab)])
        others = [n for n in chain if me is not None
                  and (nodes[n].get("author") or {}).get("login") != me]
        if others:
            lines.append([("⚠ not yours: " + ", ".join(
                f"#{n} @{(nodes[n].get('author') or {}).get('login', '?')}" for n in others), warn)])
        drafts = [n for n in chain if nodes[n].get("isDraft")]
        if drafts:
            lines.append([("drafts stay drafts: " + " ".join(f"#{n}" for n in drafts), lab)])
        keys = ([("y", "stack")] + ([("m", f"merge #{number} only")] if offer_merge else [])
                + ([("u", "update first")] if offer_update else []))
        k = modal_box(f"stack #{number}", lines, keys + [("any key", "cancel")])
        if offer_merge and k == ord("m"):
            return merge_flow(repo["name"], number, force_merge=True)
        if offer_update and k == ord("u"):
            return update_flow(repo, slug, number)
        if k not in (ord("y"), ord("Y")):
            return
        modal_msg(f"linking {len(chain)} PRs...")
        cmd = ["gh", "stack", "link", "--base", base] + [nodes[n]["url"] for n in chain]
        out = subprocess.run(cmd, capture_output=True, text=True,
                             env={**os.environ, "GH_REPO": slug})
        text = (out.stderr + out.stdout).strip()
        if out.returncode != 0:
            modal_msg(f"failed: {(text.splitlines() or ['gh failed'])[-1]}", wait_key=True)
        else:
            modal_msg(f"stacked {' '.join(f'#{n}' for n in chain)}", wait_key=True)
        for n in chain:
            fetch_waiting_pr((repo["name"], n))

    def conflict_dialog(title, why, nd):
        """Explain a conflict and the local steps to fix it; c copies them."""
        steps = fix_steps((nd.get("stack") or {}).get("number"), nd["headRefName"], nd["baseRefName"])
        lines = [[(why, pal["orange"])], [("prx can't resolve it — fix it locally:", pal["label"])], []] + [
            [(f"  {st}", pal["label"] if st.startswith("#") else pal["value"])] for st in steps]
        k = modal_box(title, lines, [("c", "copy commands"), ("any key", "close")])
        if k == ord("c"):
            modal_msg("copied" if copy_text("\n".join(steps)) else "no clipboard tool found")
            time.sleep(0.8)

    def update_flow(repo, slug, number):
        """Bring the live chain through `number` up to date, bottom to top:
        updatePullRequestBranch per layer (rebase on rebase-merge repos, else
        a merge commit), each layer polled until it is no longer behind
        before the next starts. Refuses conflicts up front; stops at the
        first failure (no rollback) and says what was and wasn't updated."""
        owner, name = slug.split("/")
        modal_msg(f"walking the chain of #{number}...")
        chain, nodes, err = live_chain(owner, name, number)
        if err:
            modal_msg(f"can't update: {err}", wait_key=True)
            return
        clash = [n for n in chain if nodes[n].get("mergeable") == "CONFLICTING"]
        if clash:
            return conflict_dialog(f"update #{number}", f"#{clash[0]} has a merge conflict",
                                   nodes[clash[0]])
        fetch_behind(owner, name, [nodes[n] for n in chain])
        if not any((nodes[n].get("_behind") or 0) > 0 for n in chain):
            modal_msg(f"#{number} is up to date", wait_key=True)
            for n in chain:
                fetch_waiting_pr((repo["name"], n))
            return
        val, lab, warn = pal["value"], pal["label"], pal["orange"]
        # chains and stacks always rebase (GitHub's stacked PRs rely on it: a
        # merge commit leaves the stack needing gh stack rebase); a lone PR
        # follows the repo, with a merge commit unless it lands with rebase
        rebase = (len(chain) > 1 or bool(nodes[chain[0]].get("stack"))
                  or (nodes[chain[0]].get("repository") or {}).get("viewerDefaultMergeMethod") == "REBASE")
        lines = [[("update ", lab), (f"{len(chain)} PR{'s' if len(chain) > 1 else ''}", val),
                  (" bottom to top with ", lab), ("rebase" if rebase else "a merge commit", val),
                  (" each:", lab)]]
        for n in chain:
            nd = nodes[n]
            b = nd.get("_behind")
            lines.append([(f"  #{n} ", val), (f"{nd['baseRefName']} ← {nd['headRefName']}", lab),
                          (f"  behind {b}" if b else "  up to date" if b == 0 else "", lab)])
        others = [n for n in chain if me is not None
                  and (nodes[n].get("author") or {}).get("login") != me]
        if others:
            lines.append([("⚠ not yours: " + ", ".join(
                f"#{n} @{(nodes[n].get('author') or {}).get('login', '?')}" for n in others)
                + (" — rewrites their branch" if rebase else ""), warn)])
        if rebase:
            lines.append([("⚠ rewrites every branch: local checkouts must reset", warn)])
        k = modal_box(f"update #{number}", lines, [("y", "update"), ("any key", "cancel")])
        if k not in (ord("y"), ord("Y")):
            return
        done, fail = [], None
        for i, n in enumerate(chain):
            nd = nodes[n]
            modal_msg(f"updating #{n} ({i + 1}/{len(chain)})...")
            fetch_behind(owner, name, [nd])  # the layer below may just have moved
            if nd.get("_behind") == 0:
                done.append(n)
                continue
            mutation = ("mutation{updatePullRequestBranch(input:{pullRequestId:%s,updateMethod:%s})"
                        "{pullRequest{number}}}" % (json.dumps(nd["id"]), "REBASE" if rebase else "MERGE"))
            try:
                out = subprocess.run(["gh", "api", "graphql", "-f", f"query={mutation}"],
                                     capture_output=True, text=True, timeout=GH_TIMEOUT)
                fail = gh_err(out) if out.returncode != 0 else None
            except subprocess.TimeoutExpired:
                fail = f"gh timed out after {GH_TIMEOUT}s"
            for _ in range(30 if not fail else 0):  # GitHub updates asynchronously
                time.sleep(2)
                fetch_behind(owner, name, [nd])
                if nd.get("_behind") == 0:
                    break
            else:
                fail = fail or "still behind after 60s"
            if fail:
                break
            done.append(n)
        rest = chain[len(done) + (1 if fail else 0):]
        msg = "updated " + (" ".join(f"#{n}" for n in done) or "nothing")
        if fail:
            msg += f" · failed #{chain[len(done)]}: {fail}"
        if rest:
            msg += " · untouched " + " ".join(f"#{n}" for n in rest)
        for n in chain:
            fetch_waiting_pr((repo["name"], n))
        if fail and "conflict" in fail.lower():  # GitHub found a real conflict mid-run
            return conflict_dialog(f"update #{number}", msg, nodes[chain[len(done)]])
        modal_msg(msg, wait_key=True)

    def rerun_flow(repo, slug, row):
        """Re-run the canceled jobs of each workflow whose newest run was
        canceled (gh run rerun --failed: failed and canceled jobs and what
        depends on them), after a y confirm; then refresh the PR."""
        runs = row["rerun"]
        if not runs:
            modal_msg(f"#{row['number']}: no canceled run found", wait_key=True)
            return
        val, lab, warn = pal["value"], pal["label"], pal["orange"]
        lines = [[(row["title"], val)], [], [("re-run the canceled jobs of:", lab)]]
        lines += [[(f"  {wf} ", val), (f"run {rid}", lab)] for rid, wf in runs.items()]
        lines.append([("starts CI that others see and that costs Actions minutes", lab)])
        if not row["mine"]:
            lines.append([(f"⚠ not your PR — author @{row['login']}", warn)])
        k = modal_box(f"rerun #{row['number']}", lines, [("y", "rerun"), ("any key", "cancel")])
        if k not in (ord("y"), ord("Y")):
            return
        ok, fail = [], None
        for rid in runs:
            modal_msg(f"re-running run {rid}...")
            try:
                out = subprocess.run(["gh", "run", "rerun", str(rid), "--failed", "-R", slug],
                                     capture_output=True, text=True, timeout=GH_TIMEOUT)
                fail = gh_err(out) if out.returncode != 0 else None
            except subprocess.TimeoutExpired:
                fail = f"gh timed out after {GH_TIMEOUT}s"
            if fail:
                break
            ok.append(rid)
        msg = "re-running " + (", ".join(runs[r] for r in ok) or "nothing")
        modal_msg(msg + (f" · failed: {fail}" if fail else ""), wait_key=True)
        fetch_waiting_pr((repo["name"], row["number"]))

    def merge_flow(repo_name, number, force_merge=False):
        """M: refresh, recheck, confirm with y, then merge (gh pr merge, SHA
        pinned), land (gh stack merge up to this PR), or stack (gh stack link,
        see stack_flow) — whatever the row's M target is. force_merge: the
        stack dialog's m escape, merge a ready chain bottom on its own."""
        repo = next((r for r in cfg["repos"] if r["name"] == repo_name), None)
        if not repo:
            return
        slug = repo_slug(repo["url"])
        modal_msg(f"checking #{number}...")
        for attempt in range(3):  # GitHub computes merge state lazily: UNKNOWN first
            try:
                node, err = fetch_pr(repo, number)
            except Exception as e:
                node, err = None, str(e)
            if err or not node or node.get("mergeStateStatus") != "UNKNOWN":
                break
            time.sleep(1.5)
        if node and not err:  # the M target depends on drift: count it fresh too
            fetch_behind(*slug.split("/"), [node])
        if err or not node:
            modal_msg(f"error: {err or 'PR not found'}", wait_key=True)
            return
        row = build_rows(repo, [node], authors, True, me)[0]
        key = (repo_name, number)
        with lock:
            state["rows"] = [r for r in state["rows"]
                             if (r["repo"], r["number"]) != key] + [row]
            mark_chains(state["rows"])
        bottom_stack = row["action"] == "stack" and not row.get("parent_pr")
        act = "merge" if force_merge and bottom_stack else row.get("m")
        if act == "stack":
            return stack_flow(repo, slug, number, offer_merge=bottom_stack,
                              offer_update=row["upd"])
        if act == "update":
            return update_flow(repo, slug, number)
        if act == "rerun":
            return rerun_flow(repo, slug, row)
        if act not in ("merge", "land"):
            act = row["action"]
            modal_msg(f"#{number} is now {act}: {ACTION_WHY[act]}", wait_key=True)
            return
        val, lab, warn = pal["value"], pal["label"], pal["orange"]
        ital = val | getattr(curses, "A_ITALIC", 0)
        method = row["method"].lower()
        st = row["stack"] if act == "land" else None
        if st and not gh_stack_installed():
            bottom = st["layers"][0]["number"]
            k = modal_box(f"#{number}", [
                [(f"#{number} is layer {st['position']} of stack #{st['number']}", val)],
                [],
                [("Options:", lab)],
                [("- merge bottom ", lab), (f"#{bottom}", ital), (" first", lab)],
                [("- install ", lab), (GH_STACK_INSTALL, ital)],
            ], [("b", "merge bottom"), ("c", "copy install cmd"), (keycap("esc"), "cancel")])
            if k == ord("b"):
                merge_flow(repo_name, bottom)
            elif k == ord("c"):
                modal_msg("copied" if copy_text(GH_STACK_INSTALL) else "no clipboard tool found")
                time.sleep(0.8)
            return
        into = st and row["default_branch"] or row["base"]
        lines = [[(row["title"], val)], [], [(f"{method} into ", lab), (into, val)]]
        if st:
            nums = " ".join(f"#{ly['number']}" for ly in st["layers"])
            lines.append([("lands ", lab), (nums, val),
                          (f" (stack #{st['number']}, all or nothing)", lab)])
        lines.append([("branch will be deleted" if row["delete_branch"] else "branch kept", lab)])
        if row["merge_queue"]:
            lines.append([("base uses a merge queue: this queues, not merges", lab)])
        if st:
            others = [ly for ly in st["layers"] if me is None or ly["login"] != me]
            if others:
                lines.append([("⚠ not yours: " + ", ".join(
                    f"#{ly['number']} @{ly['login']}" for ly in others), warn)])
        else:
            if not row["mine"]:
                lines.append([(f"⚠ not your PR — author @{row['login']}", warn)])
            # native stacks restack on GitHub; plain children need a manual rebase
            kids = [] if row["stack"] else [
                r for r in state["rows"] if r["repo"] == repo_name
                and r["base"] == row["branch"] and r["status"] in ("open", "draft")]
            if kids:
                lines.append([("⚠ rebase --onto after: " + " ".join(
                    f"#{r['number']}" for r in kids), warn)])
        offer_stack = (act == "merge" and not force_merge and linkable(row)
                       and bool(row.get("kids")))
        keys = ([("y", act)] + ([("s", "stack chain")] if offer_stack else [])
                + ([("u", "update first")] if row["upd"] else []))
        k = modal_box(f"{act} #{number}", lines, keys + [("any key", "cancel")])
        if offer_stack and k == ord("s"):
            return stack_flow(repo, slug, number)
        if row["upd"] and k == ord("u"):
            return update_flow(repo, slug, number)
        if k not in (ord("y"), ord("Y")):
            return
        env = None
        if st:
            # the stack number: gh stack merge then takes every layer, all or nothing
            cmd = ["gh", "stack", "merge", str(st["number"]), "--merge-method", method, "--yes"]
            env = {**os.environ, "GH_REPO": slug}
        else:
            cmd = ["gh", "pr", "merge", str(number), "-R", slug, f"--{method}",
                   "--match-head-commit", row["head_oid"]]
        modal_msg(f"{'landing' if st else 'merging'} #{number}...")
        out = subprocess.run(cmd, capture_output=True, text=True, env=env)
        text = (out.stderr + out.stdout).strip()
        if out.returncode != 0:
            modal_msg(f"failed: {(text.splitlines() or ['gh failed'])[-1]}", wait_key=True)
        elif row["merge_queue"] or "queue" in text.lower():
            modal_msg(f"#{number} added to the merge queue", wait_key=True)
        else:
            modal_msg("landed " + " ".join(f"#{ly['number']}" for ly in st["layers"]) if st
                      else f"merged #{number}", wait_key=True)
        for n in ([ly["number"] for ly in st["layers"]] if st else [number]):
            fetch_waiting_pr((repo_name, n))

    def fetch_repo_page1(repo):
        """Upsert the newest OPEN page so new PRs appear between full
        refreshes. No prune — the full refresh handles vanished rows, and
        the display filter drops rows that age out of the time window."""
        if any(rn == repo["name"] for rn, _ in state["pending"]):
            return

        def work():
            try:
                owner, name = repo_slug(repo["url"]).split("/")
                nodes, _, err = fetch_page(owner, name, "OPEN", None)
                if err or not nodes:
                    return
                carry_behind(cache_of(repo)["nodes"], nodes)
                new = build_rows(repo, nodes, authors, show_all, me)
                nums = {r["number"] for r in new}
                with lock:
                    state["rows"] = [r for r in state["rows"]
                                     if r["repo"] != repo["name"]
                                     or r["number"] not in nums] + new
            except Exception:
                pass  # next tick retries
        threading.Thread(target=work, daemon=True).start()

    def start_waiting_fetch():
        state["w_started"] = time.time()
        for key in waiting:
            fetch_waiting_pr(key)
        for repo in scope()[2]:  # keep the list itself fresh too
            fetch_repo_page1(repo)

    start_fetch()
    while True:
        with lock:
            mark_chains(state["rows"])  # upserts rebuild rows without chain context
        rows = filter_rows(state["rows"], state_f, window)
        if author_f:
            rows = [r for r in rows if r["author"] == author_f]
        if repo_f:
            rows = [r for r in rows if r["repo"] == repo_f]
        if search_q:
            rows = [r for r in rows if fuzzy_match(search_q, r)]

        def order(rs):
            if by == "stack":
                return stack_order(sort_rows(rs, "repo"))
            rs = sort_rows(rs, by)
            heads = {(r["repo"], r["branch"]) for r in rs}
            bases = {(r["repo"], r["base"]) for r in rs}
            return rs, ["▪" if (r["repo"], r["base"]) in heads  # is a child
                        or (r["repo"], r["branch"]) in bases    # is a parent
                        else "" for r in rs]

        # display list: per-org sections ("hdr") when showing all orgs
        show_hdr = org_f is None and len(org_list) > 1
        lines = []
        for org in (org_list if org_f is None else [org_f]):
            sub = [r for r in rows if r["org"] == org]
            if not sub:
                continue
            sub, marks = order(sub)
            if show_hdr:
                if lines:  # spacer between sections, none before the first
                    lines.append(("blank", "", ""))
                lines.append(("hdr", org,
                              f" {len(sub)} {icon('pr')}"))
                lines.append(("colhdr", "", ""))
            lines += [("row", r, m) for r, m in zip(sub, marks)]
        if widen and not sync_due and not state["pending"]:
            widen = False
        if widen:
            lines.append(("loading", "", ""))
        selectable = [i for i, ln in enumerate(lines) if ln[0] == "row"]
        if snap_best:
            snap_best = False
            if search_q and selectable and \
                    str(cfg.get("search_select_best", "true")).lower() != "false":
                scores = [fuzzy_score(search_q, lines[li][1]) for li in selectable]
                cursor, top = scores.index(max(scores)), 0
        if selectable:
            cursor = max(0, min(cursor, len(selectable) - 1))
        cur_row = lines[selectable[cursor]][1] if selectable else None

        height, width = stdscr.getmaxyx()
        cw = compact or width < COMPACT_BELOW  # effective compact view
        hdr_line = HEADER_C if cw else HEADER
        # sections carry their own column header; otherwise a blank line and
        # the fixed header sit between the top bar and the content
        y_start = 2 if show_hdr else 4
        body = height - 1 - y_start
        top = max(0, min(top, max(0, len(lines) - body)))
        if selectable:
            top, up, down = scroll_window(len(lines), body, top, selectable[cursor])
        else:
            up, down = False, False
        # "↑ N more" / "↓ N more" replace the edge lines while rows hide there
        up_n = sum(1 for i in selectable if i <= top) if up else 0
        down_n = sum(1 for i in selectable if i >= top + body - 1) if down else 0

        stdscr.erase()
        spin = (spin + 1) % len(SPINNER)
        ind = SPINNER[spin] if state["pending"] else "·"
        border, bold = pal["border"], curses.A_BOLD

        keymode = show_keys or time.time() < peek_until
        # nerd font off: labels always lead with the trigger key (gray at rest,
        # bold when peeking); with nerd font: icon at rest, bold key on peek
        lead = (pal["value"] | bold) if keymode else pal["label"]

        def flead(k):  # leading glyph for filter k: icon or trigger key
            return keycap(FILTER_KEY[k]) if (keymode or not NF) else icon("f_" + k)

        x = draw_tag(stdscr, pal, 0, 1, [(f" {flead('org')} ", lead),
                     ("org ", pal["label"]), (f"{org_f or 'all'} ", pal["value"] | bold)])
        auto = " auto " if auto_on else " manual "
        at = (f" last sync {since_str(state['at'])} ago " if state["at"]
              else f" restored {since_str(state['restored'])} ago " if state.get("restored")
              else " loading ")
        rx = max(x, width - len(auto) - len(at) - 3)
        rx = draw_tag(stdscr, pal, 0, rx, [(auto, pal["label"])])
        draw_tag(stdscr, pal, 0, rx, [(at, pal["label"]), (ind, pal["purple"])])
        prs = f" {len(selectable)} {icon('pr')}"
        draw_tag(stdscr, pal, 1, max(1, width - len(prs) - 1), [(prs, pal["accent"])])
        x = 1
        for k, val in (
            ("state", state_f),
            ("repo", repo_f or "all"),
            ("author", author_f or "all"),
            ("last", window),
            ("sort", by),
        ):
            name = FILTER_LABEL.get(k, k)
            parts = [(f" {flead(k)} ", lead), (f"{name} ", pal["label"]),
                     (f"{val} ", pal["value"] | bold)]
            x = draw_tag(stdscr, pal, 1, x, parts)

        act_hdr_x = max(2, width - ACTW)
        if not show_hdr:
            safe_add(stdscr, 3, 2, hdr_line, pal["label"] | bold)
            safe_add(stdscr, 3, act_hdr_x, "ACTION", pal["label"] | bold)
        for y, ln in enumerate(lines[top:top + body]):
            yy = y + y_start
            if (y == 0 and up) or (y == body - 1 and down):
                safe_add(stdscr, yy, 2, f"↑ {up_n} more" if y == 0 and up
                         else f"↓ {down_n} more", pal["muted"])
                continue
            if ln[0] == "blank":
                continue
            if ln[0] == "hdr":
                og = f"{icon('org')} " if NF else ""
                lbl = f"─ {og}{ln[1]} "
                # stop at width-2: filling the last cell throws in addstr,
                # which leaves ncurses repainting the line from a stale model
                text = lbl + "─" * max(0, width - 3 - len(lbl))
                safe_add(stdscr, yy, 2, text, pal["accent"])
                safe_add(stdscr, yy, max(2, width - len(ln[2]) - 1),
                         ln[2], pal["accent"])
                continue
            if ln[0] == "loading":
                scope_lbl = " · ".join(p for p in (
                    repo_f, None if state_f == "all" else state_f, window) if p)
                busy = sorted({rn for rn, _ in state["pending"]})
                safe_add(stdscr, yy, 2, f"{SPINNER[spin]} loading {scope_lbl}"
                         + (f" · {', '.join(busy)}" if busy else ""), pal["muted"])
                continue
            if ln[0] == "colhdr":
                safe_add(stdscr, yy, 2, hdr_line, pal["label"] | bold)
                safe_add(stdscr, yy, act_hdr_x, "ACTION", pal["label"] | bold)
                continue
            row, mark = ln[1], ln[2]
            sel = curses.A_REVERSE if (selectable and top + y == selectable[cursor]) else 0
            if sel:
                safe_add(stdscr, yy, 1, " " * (width - 2), sel)
            segs = row_segments(row, cw)
            pr_i = 1 if cw else 2  # index of the PR number segment
            key = (row["repo"], row["number"])
            group = STATUS_GROUP[row["status"]]
            if (row["repo"], group) in state["pending"] or key in state["pending_prs"]:
                segs[0] = (f"{SPINNER[spin]}  ", "purple")
            if key in waiting:
                segs[pr_i] = (segs[pr_i][0], "purple")  # PR number column
            mark, mclr = rail_mark(mark, row)
            segs.insert(pr_i, (f"{mark:<2}", mclr))  # stack rail
            if search_q and str(cfg.get("search_highlight", "true")).lower() != "false":
                pat = match_pattern(search_q)
                if pat:
                    segs = highlight_segs(segs, pat)
            act_x = max(2, width - ACTW)
            x = 2
            for text, clr in segs:
                safe_add(stdscr, yy, x, text[:max(0, act_x - 1 - x)], pal[clr] | sel)
                x += len(text)
            text, clr = action_segment(row)
            safe_add(stdscr, yy, act_x, text, pal[clr] | sel)

        fx = 1
        if search_q is not None:
            fx = draw_tag(stdscr, pal, height - 1, fx,
                          [(f" /{search_q}{'_' if search_edit else ''} ",
                            pal["purple"] | bold)])
        if time.time() - last_q < 2:
            draw_tag(stdscr, pal, height - 1, fx,
                     [(" press q again to quit ", pal["orange"] | curses.A_BOLD)])
        elif time.time() < toast["until"]:
            draw_tag(stdscr, pal, height - 1, fx, [(f" {toast['text']} ", pal["green"])])
        elif state["errors"]:
            draw_tag(stdscr, pal, height - 1, fx,
                     [(f" {state['errors'][0]} ", pal["red"])])
        else:
            # (action name or None, key name, label). peek or nerd-off -> the
            # key (keycap); otherwise the action icon. search-edit has no
            # action icons, so it always shows the key.
            hints = (((None, "enter", "keep"), (None, "esc", "clear"))
                     if search_edit
                     else (("quit", "q", "quit"), ("settings", ",", "settings"),
                           (None, "h", "hints"), ("help", "?", "help")))
            x = fx
            for action, key_name, label in hints:
                if action and NF and not keymode:
                    hint = icon(action)
                else:
                    hint = keycap(key_name)
                x = draw_tag(stdscr, pal, height - 1, x,
                             [(f" {hint} ", lead), (f"{label} ", pal["label"])])
            if not search_edit and cur_row:
                # the selected row's most practical key: right-aligned, key only (no icon)
                hk, hl = row_hint(cur_row, (cur_row["repo"], cur_row["number"]) in waiting)
                tag = [(f" {hk} ", lead), (f"{hl} ", pal["label"])]
                rx = width - 2 - sum(len(t) for t, _ in tag)
                if rx > x:
                    draw_tag(stdscr, pal, height - 1, rx, tag)
        stdscr.refresh()

        snap = (window, by, state_f, org_f, repo_f, author_f, auto_on, compact,
                tuple(sorted(waiting)))
        if snap != last_snap:
            last_snap = snap
            save_state(state_path, {
                "window": window, "by": by, "state": state_f, "org": org_f,
                "repo": repo_f, "author": author_f, "auto_on": auto_on,
                "compact": compact,
                "waiting": sorted(list(w) for w in waiting)})

        if (auto_on and refresh_s and not state["pending"]
                and time.time() - state["started"] >= refresh_s):
            start_fetch()
        if sync_due and time.time() >= sync_due and not state["pending"]:
            sync_due = None
            start_fetch()
        if waiting:  # a waiting PR that merged/closed is done: stop watching it
            waiting -= {(r["repo"], r["number"]) for r in state["rows"]
                        if r["status"] in ("merged", "closed")}
        if wait_s and waiting and time.time() - state["w_started"] >= wait_s:
            start_waiting_fetch()

        def cyc(seq, cur, step):
            return seq[(seq.index(cur) + step) % len(seq)]

        key = stdscr.getch()
        if search_edit and key != -1:  # search input captures printable keys
            if key == 27:
                search_q, search_edit = None, False
            elif key in (curses.KEY_ENTER, 10, 13):
                search_edit = False
                if not search_q.strip():  # empty/whitespace query: cancel
                    search_q = None
            elif key in (curses.KEY_BACKSPACE, 127, 8):
                search_q = search_q[:-1]
            elif 32 <= key < 127:
                search_q += chr(key)
            else:
                pass  # arrows etc. are ignored while typing
            cursor, top, snap_best = 0, 0, True
            key = -1
        step = -1 if key in (ord("S"), ord("R"), ord("L"),
                             ord("B"), ord("A"), ord("O")) else 1
        if key == ord("q"):
            if time.time() - last_q < 2:
                return
            last_q = time.time()
        elif key != -1:
            last_q = 0.0  # any other key withdraws the quit intention
        if key == ord(","):
            settings_modal()
        elif key == 27:
            start_fetch()  # refresh everything the current filters show
        elif key == ord("0"):  # reset all filters/sort/search to defaults (org stays)
            state_f, window, by = "all", "week", "stack"
            author_f = repo_f = search_q = None
            search_edit = False
            cursor, top = 0, 0
            sync_due = time.time() + 3 if coverage_missing() else None
            widen = widen or sync_due is not None
        elif key in (ord("r"), ord("R")):
            repo_f = cyc(repos_of(org_f), repo_f, step)
            cursor, top = 0, 0
        elif key in (ord("s"), ord("S")):
            state_f = cyc(STATE_FILTERS, state_f, step)
            cursor, top = 0, 0
        elif key in (ord("b"), ord("B")):
            by = cyc(SORTS, by, step)
            cursor, top = 0, 0
        elif key in (ord("l"), ord("L")):
            window = cyc(WINDOWS, window, step)
            cursor, top = 0, 0
        elif key in (ord("a"), ord("A")):
            author_f = cyc(author_cycle, author_f, step)
            cursor, top = 0, 0
        elif key in (ord("o"), ord("O")):
            org_f = cyc([None] + org_list, org_f, step)
            if repo_f not in repos_of(org_f):  # a repo filter from another org
                repo_f = None
            cursor, top = 0, 0
        elif key == ord("/"):
            search_edit = True
            search_q = search_q or ""
            cursor, top = 0, 0
        elif key == ord("?"):
            help_modal()
        if key in (ord("s"), ord("S"), ord("l"), ord("L"),
                   ord("r"), ord("R"), ord("o"), ord("O")):
            # widened scope: sync after a 3s debounce (org: immediately,
            # switching orgs is a deliberate choice); narrowed: cancel
            if not coverage_missing():
                sync_due = None
            elif key in (ord("o"), ord("O")):
                sync_due, widen = time.time(), True
            else:
                sync_due, widen = time.time() + 3, True
        elif key == 9:  # Tab
            auto_on = not auto_on
        elif key == ord("c"):
            compact = not compact
        elif key == ord("h"):
            peek_until = time.time() + PEEK_HOLD  # hold for hints; repeats extend it
        elif key == ord("w") and cur_row:
            wkey = (cur_row["repo"], cur_row["number"])
            waiting.symmetric_difference_update({wkey})
            if wkey in waiting:  # just turned on: refresh now, then on the next tick
                fetch_waiting_pr(wkey)
        elif key in (curses.KEY_DOWN, ord("j")):
            cursor += 1
        elif key in (curses.KEY_UP, ord("k")):
            cursor = max(0, cursor - 1)
        elif key in (curses.KEY_ENTER, 10, 13) and cur_row:
            sel_rows = [lines[li][1] for li in selectable]
            cursor = detail_modal(sel_rows, cursor)
        elif key == ord(" ") and cur_row:
            fetch_waiting_pr((cur_row["repo"], cur_row["number"]))
        elif key == ord("M") and cur_row and cur_row.get("m"):
            merge_flow(cur_row["repo"], cur_row["number"])
        elif key in (ord("y"), ord("Y")) and cur_row:
            yank(cur_row, "number" if key == ord("y") else "url")
        elif key == curses.KEY_RESIZE:
            top = 0


def selftest():
