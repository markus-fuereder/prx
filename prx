def ci_icon(row):
    """One icon for the loudest check state: 󰅙 red any failed, 󰐾 yellow any
    running, 󰝦 gray queued, 󰜺 gray canceled (no result), 󰗡 green all
    passed, - when no checks."""
    passed, failed, running, queued, canceled = row["checks"]
    if not passed + failed + running + queued + canceled:
        return icon("ci_none"), "gray"
    if failed:
        return icon("ci_fail"), "red"
    if running:
        return icon("ci_run"), "yellow"
    if queued:
        return icon("ci_queue"), "gray"
    if canceled:
        return icon("ci_cancel"), "gray"
    return icon("ci_pass"), "green"


def reviewer_segments(row):
    """Three fixed slots, blank-padded to REVW so they line up in every row:
    verdict — 󰔑N change-requesters (red) if any, else 󰔓N approvals (green),
    󰔓0 dark gray when neither; pending — 󰭖N open requests, people plus
    teams (gray, orange if any is a team or an outsider; 󰭖0 dark gray); then
    me with my state: 󰈈me requested (blue), 󰔑me changes (red), 󰔓me approved
    (green). ASCII: +N -N ?N, ?me -me +me."""
    others = [rv for rv in row["reviewers"] if not rv.get("me")]
    approved = [rv for rv in row["reviewers"] if rv["state"] == "approved"]
    changes = [rv for rv in others if rv["state"] == "changes"]
    people = [rv for rv in others if rv["state"] == "pending" and not rv.get("team")]
    teams = sum(int(rv["name"].partition("×")[2] or 1)  # label "team" or "team×N"
                for rv in row["reviewers"] if rv.get("team"))
    mine = next((rv for rv in row["reviewers"] if rv.get("me")), None)

    def slot(glyph, n, c):  # ponytail: counts cap at 9 to keep slots 2 wide
        return (f"{icon(glyph)}{min(n, 9)}", c if n else "darkgray")

    if changes:
        verdict = slot("rev_changes", len(changes), "red")
    else:
        verdict = slot("approve", len(approved), "green")
    odd = teams or not all(rv.get("known", True) for rv in people)
    segs = [verdict, (" ", "label"),
            slot("rev_pending", len(people) + teams, "orange" if odd else "gray")]
    if mine:
        glyph, c = {"pending": ("rev_requested", "mine"), "changes": ("rev_changes", "red"),
                    "approved": ("approve", "green")}[mine["state"]]
        segs += [(" ", "label"), (f"{icon(glyph)}me", c)]
    used = sum(len(t) for t, _ in segs)
    return segs + [(" " * (REVW - used), "label")]


