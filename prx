    def detail_modal(rows, idx):
        """Detail card; j/k/arrows move through rows. Returns the final index.
        Re-reads the live row each tick so watch/refresh updates show at once."""
        dspin = 0

        def wrap(s, w):
            out, line = [], ""
            for word in s.split():
                if len(line) + len(word) + 1 > w:
                    out.append(line)
                    line = word
                else:
                    line = f"{line} {word}".strip()
            if line:
                out.append(line)
            return out or [""]

        while True:
            idx = max(0, min(idx, len(rows) - 1))
            key = (rows[idx]["repo"], rows[idx]["number"])
            # render the live copy so background updates appear immediately
            with lock:
                mark_chains(state["rows"])
            row = next((x for x in state["rows"]
                        if (x["repo"], x["number"]) == key), rows[idx])
            loading = (key in state["pending_prs"]
                       or (key[0], STATUS_GROUP[row["status"]]) in state["pending"])
            dspin = (dspin + 1) % len(SPINNER)
            height, width = stdscr.getmaxyx()
            mw = max(50, min(84, width - 4))
            iw = mw - 4  # inner text width
            p, f, r, q, cx = row["checks"]
            ci_g, ci_c = ci_icon(row)
            def stack_lines():
                rr = [x for x in state["rows"] if x["repo"] == row["repo"]]
                ordered, marks = stack_order(sort_rows(rr, "repo"))
                idx = next((i for i, x in enumerate(ordered)
                            if x["number"] == row["number"]), None)
                if idx is None or marks[idx] == "":
                    return []  # not part of a stack -> section omitted
                s = idx
                while s > 0 and marks[s] != "▪":
                    s -= 1
                e = s
                while e < len(marks) - 1 and marks[e] != "└":
                    e += 1
                out = []
                for i in range(s, e + 1):
                    x = ordered[i]
                    cur = x["number"] == row["number"]
                    out.append((f"{rail_mark(marks[i], x)[0]} #{x['number']} {x['branch']}",
                                "stackcur" if cur else "stack"))
                return out

            stk = stack_lines()
            secs = [
                ("about", [
                    (f"branch   {row['base']} ← {row['branch']}"
                     + (f" · behind {row['behind']}" if row.get("behind") else ""), "label"),
                    (f"repo     {row['repo']} · {row['org']}", "label"),
                    (f"author   {row['author']} (@{row['login']})", "label"),
                    (f"age      created {age_str(row['created'])} ago · "
                     f"updated {age_str(row['updated'], hours=True)} ago", "label"),
                ]),
                ("status", [(f"{icon(row['status'])} {row['status'].upper()}",
                             STATUS_COLOR.get(row["status"], "value"))]),
            ]
            if stk:  # only when the PR is part of a stack
                secs.append(("stack", stk))
            secs += [
                ("reviews", None),
                ("comments", [(f"{row['comments'][0]} open · {row['comments'][1]} resolved · "
                               f"{row['comments'][2]} total",
                               "orange" if row["comments"][0] else
                               "green" if row["comments"][2] else "label")]),
                ("ci", [(f"{ci_g} {row['ci']}   {p} passed, {f} failed, "
                         f"{r} running, {q} queued" + (f", {cx} canceled" if cx else ""), ci_c)]),
                ("action", [(f"{icon(row['action'])} {row['action']}",
                             "green" if row["action"] == "done"
                             else ACTION_COLOR[row["action"]]),
                            (ACTION_WHY.get(row["action"], ""), "muted")]
                 + ([(f"  {st}", "label") for st in fix_steps(
                     (row.get("stack") or {}).get("number"), row["branch"], row["base"])]
                    if row["action"] == "rebase" else [])),
            ]
            rev = []
            dec = DECISION_LABEL.get(row["decision"], "no review required")
            rev.append((dec + (" · outside review needed"
                               if row.get("ext_review") else ""), "value"))
            rcolor = {"approved": "green", "changes": "red", "pending": "label"}
            for rv in row["reviewers"]:
                c = "me" if rv.get("me") else rcolor.get(rv["state"], "label")
                if rv.get("team"):  # real name needs read:org; keep any ×N count
                    name, tag = rv["name"].replace("team", "team review"), ""
                else:
                    name = rv["name"]
                    tag = "" if rv.get("known", True) else " (outsider)"
                rev.append((f"  {rv['state']:<8} {name}{tag}", c))
            secs = [(n, rev if n == "reviews" else ls) for n, ls in secs]
            pad = not (compact or width < COMPACT_BELOW)  # spacer between sections
            body = []  # (text, color): "hdr" divider, "gap" blank, else text
            for t in wrap(row["title"], iw):
                body.append((t, "value"))
            for name, ls in secs:
                if pad:
                    body.append(("", "gap"))
                body.append((name, "hdr"))
                body += ls

            mpad = 1 if pad else 0  # blank line inside top and bottom borders
            mh = min(len(body) + 2 + 2 * mpad, height - 2)
            y0, x0 = (height - mh) // 2, (width - mw) // 2
            wkey = key
            num_clr = pal["purple"] if wkey in waiting else pal["value"]
            stdscr.erase()
            safe_add(stdscr, y0, x0, "┌" + "─" * (mw - 2) + "┐", pal["border"])
            draw_tag(stdscr, pal, y0, x0 + 2,
                     [(f" #{row['number']} ", num_clr | curses.A_BOLD)])
            if loading:  # fetch in flight: spinner in the top-left border
                safe_add(stdscr, y0, x0 + 1, SPINNER[dspin], pal["purple"])
            for r in range(y0 + 1, y0 + mh - 1):  # box sides, incl. padding rows
                safe_add(stdscr, r, x0, "│", pal["border"])
                safe_add(stdscr, r, x0 + mw - 1, "│", pal["border"])
            for i, (t, c) in enumerate(body[:mh - 2 - 2 * mpad]):
                yy = y0 + 1 + mpad + i
                if c == "gap":  # blank spacer line
                    continue
                if c == "hdr":  # divider
                    safe_add(stdscr, yy, x0 + 2,
                             f"─ {t} " + "─" * max(0, mw - 6 - len(t)), pal["muted"])
                elif c in ("stack", "stackcur"):  # purple rail marker, then row
                    mk, _, rest = t.partition(" ")
